{
  "name": "PunkMeAngel",
  "globIgnorePaths": ["**/*.spec.lua", "**/package.json", "**/.gitkeep"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Config": {
        "$path": "src/ReplicatedStorage/Config"
      },
      "Remotes": {
        "$path": "src/ReplicatedStorage/Remotes"
      }
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },
    "ServerStorage": {
      "$path": "src/ServerStorage"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "StarterGui": {
      "$path": "src/StarterGui"
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "World": {
        "$path": "src/Workspace"
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 21,
        "Brightness": 2,
        "GlobalShadows": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
