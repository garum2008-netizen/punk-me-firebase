      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">EndingScenes</string>
          <string name="Source"><![CDATA[--!strict
return {
	ending_break_curse = {
		ru = "Колокол звенит снова над Веной. Проклятие слабеет — мёртвины снова люди. Призраки находят путь в Склеп. Виенна поёт на площади, Рейзор кивает тебе как равному.",
		en = "The Bell rings over Vienna again. The curse weakens — Mortwins are human. Ghosts find the Crypt. Vienna sings in the square; Razor nods to you as an equal.",
	},
	ending_zombie_style = {
		ru = "Зомби — стиль, не судьба. Замок превращается в клуб, неон Тусовки горит до утра. Склеп держит призраков, но город танцует.",
		en = "Zombie is style, not fate. The castle becomes a club; hangout neon burns till dawn. The Crypt holds ghosts, but the city dances.",
	},
	ending_count_deal = {
		ru = "Граф открывает ночной магазин у кладбища. Семья в безопасности, призраки под охраной сделки. Колокол молчит — но город живёт по новым правилам.",
		en = "The Count opens a night shop by the cemetery. Family safe, ghosts under the deal's guard. The Bell is silent — but the city lives by new rules.",
	},
}
]]></string>
        </Properties>
      </Item>
