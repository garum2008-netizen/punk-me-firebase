	id: string,
	chapter: number,
	startWhen: string,
	steps: { QuestStep },
	rewardGrantKey: string?,
	nextQuestId: string?,
}

export type EndingDef = {
	id: string,
	grantKey: string,
	title: { [Lang]: string },
}

local QuestTable = {}

