      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ActionGuards</string>
          <string name="Source"><![CDATA[--!strict
local FlyerEngine = if script and script.Parent then require(script.Parent.FlyerEngine) else require("./FlyerEngine")

export type Vec3 = { x: number, y: number, z: number }
export type BoxZone = {
	center: Vec3,
	size: Vec3,
}

local ActionGuards = {}

function ActionGuards.positionInBox(pos: Vec3, zone: BoxZone): boolean
	local rel = {
		x = pos.x - zone.center.x,
		y = pos.y - zone.center.y,
		z = pos.z - zone.center.z,
	}
	return math.abs(rel.x) <= zone.size.x / 2
		and math.abs(rel.y) <= zone.size.y / 2
		and math.abs(rel.z) <= zone.size.z / 2
end

function ActionGuards.distance(a: Vec3, b: Vec3): number
	local dx = a.x - b.x
	local dy = a.y - b.y
	local dz = a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

function ActionGuards.nearPoint(pos: Vec3, target: Vec3, maxDist: number): boolean
	return ActionGuards.distance(pos, target) <= maxDist
end

-- Approximate world anchors (match WorldBuilder layout)
ActionGuards.ZONES = {
	zone_duel = { center = { x = 120, y = 0, z = 120 }, size = { x = 24, y = 4, z = 24 } },
	zone_shop = { center = { x = 100, y = 5, z = -10 }, size = { x = 14, y = 10, z = 14 } },
	zone_castle_tower = { center = { x = -95, y = 11, z = 95 }, size = { x = 12, y = 22, z = 12 } },
	zone_castle_hall = { center = { x = -80, y = 5, z = 80 }, size = { x = 30, y = 10, z = 30 } },
}

ActionGuards.FLYER_SPOTS = {
	flyer_street_1 = { x = 65, y = 2, z = 8 },
	flyer_street_2 = { x = 90, y = 2, z = 12 },
	flyer_street_3 = { x = 75, y = 2, z = -5 },
	flyer_city_1 = { x = 70, y = 2, z = -55 },
	flyer_city_2 = { x = 90, y = 2, z = -70 },
	flyer_city_3 = { x = 95, y = 2, z = -50 },
	flyer_cemetery_gate = { x = 5, y = 2, z = 105 },
	flyer_shop_wall = { x = 108, y = 4, z = -8 },
}

ActionGuards.NPC_ANCHORS = {
	npc_razor = { x = 70, y = 3, z = 5 },
	npc_gravedigger = { x = -5, y = 3, z = 125 },
	npc_ghost = { x = 10, y = 3, z = 130 },
	npc_count = { x = -80, y = 3, z = 80 },
	npc_zoya = { x = -65, y = 3, z = 70 },
}

export type GuardContext = {
	position: Vec3,
	action: string,
	payload: any,
}

function ActionGuards.flyerSpotAllowed(spotId: string): boolean
	for _, id in FlyerEngine.SPOT_IDS do
		if id == spotId then
			return true
		end
	end
	return false
end

function ActionGuards.validate(ctx: GuardContext): boolean
	local action = ctx.action
	local pos = ctx.position

	if action == "duel_start" then
		local z = ActionGuards.ZONES.zone_duel
		return z ~= nil and ActionGuards.positionInBox(pos, z)
	end
	if action == "shop_buy" then
		local z = ActionGuards.ZONES.zone_shop
		return z ~= nil and ActionGuards.positionInBox(pos, z)
	end
	if action == "flyer_post" then
		local spot = if type(ctx.payload) == "string" then ctx.payload else nil
		if not spot or not ActionGuards.flyerSpotAllowed(spot) then
			return false
		end
		local anchor = ActionGuards.FLYER_SPOTS[spot]
		return anchor ~= nil and ActionGuards.nearPoint(pos, anchor, 18)
	end
	if action == "tower_puzzle" then
		local z = ActionGuards.ZONES.zone_castle_tower
		return z ~= nil and ActionGuards.positionInBox(pos, z)
	end
	if action == "graph_confession" or action == "pick_ending" then
		local z = ActionGuards.ZONES.zone_castle_hall
		return z ~= nil and ActionGuards.positionInBox(pos, z)
	end
	if action == "cemetery_job" then
		local g = ActionGuards.NPC_ANCHORS.npc_gravedigger
		return g ~= nil and ActionGuards.nearPoint(pos, g, 20)
	end
	if action == "ch3_ghost" then
		local g = ActionGuards.NPC_ANCHORS.npc_ghost
		return g ~= nil and ActionGuards.nearPoint(pos, g, 18)
	end
	if action == "bell_tongue" then
		local branch = if type(ctx.payload) == "string" then ctx.payload else ""
		if branch == "zoya" then
			local z = ActionGuards.NPC_ANCHORS.npc_zoya
			return z ~= nil and ActionGuards.nearPoint(pos, z, 16)
		end
		return ActionGuards.nearPoint(pos, { x = -55, y = 4, z = 90 }, 14)
	end
	if action == "duel_action" then
		local z = ActionGuards.ZONES.zone_duel
		return z ~= nil and ActionGuards.positionInBox(pos, z)
	end
	if action == "hangout_build" then
		return ActionGuards.nearPoint(pos, { x = 80, y = 2, z = 80 }, 45)
	end
	if action == "ch3_crypt" then
		return ActionGuards.nearPoint(pos, { x = -15, y = 2, z = 140 }, 16)
	end
	return true
end

return ActionGuards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">AngelinaLines</string>
          <string name="Source"><![CDATA[--!strict
local AngelinaLines = {}

export type Lang = "ru" | "uk" | "en" | "da"
export type Context = "welcome" | "move" | "interact" | "job" | "shop" | "duel" | "save" | "stuck"

local lines: { [Context]: { [Lang]: string } } = {
	welcome = {
		ru = "Привет! Я Ангелина. Сначала выбери образ — панки любят индивидуальность.",
		uk = "Привіт! Я Ангеліна. Спочатку обери образ — панки люблять індивідуальність.",
		en = "Hi! I'm Angelina. Pick a look first — punks love personality.",
		da = "Hej! Jeg er Angelina. Vælg et look først — punks elsker personlighed.",
	},
	move = {
		ru = "Сначала подойдём поближе. На расстоянии через всю комнату даже панки пока не телепаты.",
		uk = "Спочатку підійдемо ближче. На відстані через усю кімнату навіть панки поки не телепати.",
		en = "Let's get closer first. Even punks aren't telepaths across the room.",
		da = "Lad os komme tættere på først. Selv punks er ikke telepater på tværs af rummet.",
	},
	interact = {
		ru = "Нажми кнопку взаимодействия, когда увидишь подсказку. На телефоне — круглая кнопка.",
		uk = "Натисни кнопку взаємодії, коли побачиш підказку. На телефоні — кругла кнопка.",
		en = "Press interact when you see the prompt. On mobile — the round button.",
		da = "Tryk på interager, når du ser prompten. På mobil — den runde knap.",
	},
	job = {
		ru = "Монет маловато. Давай найдём работу — диван, к сожалению, зарплату не выдаёт.",
		uk = "Монет замало. Знайдемо роботу — диван, на жаль, зарплату не видає.",
		en = "Short on coins. Let's find work — couches don't pay, sadly.",
		da = "Få mønter. Lad os finde arbejde — sofaer betaler desværre ikke.",
	},
	shop = {
		ru = "В магазине на улице можно купить декор. Сначала проверь цену.",
		uk = "У магазині на вулиці можна купити декор. Спочатку перевір ціну.",
		en = "The street shop sells decor. Check the price first.",
		da = "Butikken på gaden sælger dekoration. Tjek prisen først.",
	},
	duel = {
		ru = "В дуэли: атака, блок, уклон. Рейзор сдержится — это учебный бой.",
		uk = "У дуелі: атака, блок, ухилення. Рейзор стриматиметься — це навчальний бій.",
		en = "In duels: attack, block, dodge. Razor holds back — training fight.",
		da = "I dueller: angreb, blok, undvig. Razor holder igen — træningskamp.",
	},
	save = {
		ru = "Получилось! Теперь сохраним успех. Красивый выход тоже часть плана.",
		uk = "Вийшло! Тепер збережемо успіх. Гарний вихід теж частина плану.",
		en = "Nice! Let's save that win. A clean exit is part of the plan.",
		da = "Fedt! Lad os gemme det. En pæn afslutning er også en del af planen.",
	},
	stuck = {
		ru = "Застряла цель? Открой журнал — там текущий шаг.",
		uk = "Застрягла ціль? Відкрий журнал — там поточний крок.",
		en = "Stuck? Open the journal — your current step is there.",
		da = "Fast? Åbn journalen — dit nuværende trin står der.",
	},
}

function AngelinaLines.forContext(ctx: Context, lang: Lang): string
	local row = lines[ctx]
	if row == nil then
		return ""
	end
	return row[lang] or row.en or ""
end

return AngelinaLines
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ClientTouch</string>
          <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")

local ClientTouch = {}

function ClientTouch.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function ClientTouch.stylePrimaryButton(button: TextButton)
	if ClientTouch.isTouch() or UserInputService.TouchEnabled then
		button.Size = UDim2.new(0, math.max(button.Size.X.Offset, 112), 0, math.max(button.Size.Y.Offset, 48))
		button.TextSize = 18
	end
end

return ClientTouch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CryptBuildEngine</string>
          <string name="Source"><![CDATA[--!strict
local CryptBuildEngine = {}

CryptBuildEngine.PHASE_COUNT = 3

CryptBuildEngine.PHASE_IDS = { "stakes", "inscription", "seal" }

CryptBuildEngine.ANSWERS = {
	stakes = "4stakes",
	inscription = "mortwin",
	seal = "bellrim",
}

function CryptBuildEngine.phaseIndex(phaseId: string): number
	for i, id in CryptBuildEngine.PHASE_IDS do
		if id == phaseId then
			return i
		end
	end
	return 0
end

function CryptBuildEngine.validate(phaseId: string, answer: string, completedPhase: number): boolean
	local idx = CryptBuildEngine.phaseIndex(phaseId)
	if idx == 0 then
		return false
	end
	if idx ~= completedPhase + 1 then
		return false
	end
	return answer == CryptBuildEngine.ANSWERS[phaseId]
end

function CryptBuildEngine.isComplete(completedPhase: number): boolean
	return completedPhase >= CryptBuildEngine.PHASE_COUNT
end

return CryptBuildEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
