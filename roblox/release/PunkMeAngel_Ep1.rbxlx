    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">GameServer</string>
        <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProfileService = require(script.Parent.ProfileService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local MonetizationService = require(script.Parent.MonetizationService)
local StoryHandlers = require(script.Parent.StoryHandlers)

local RemoteValidation = require(ReplicatedStorage.Shared.RemoteValidation)
local QuestEngine = require(ReplicatedStorage.Shared.QuestEngine)
local GameServer = {}

local rateBuckets: { [number]: { [string]: RemoteValidation.Bucket } } = {}

local function getBucket(userId: number, action: string): RemoteValidation.Bucket
	local userBuckets = rateBuckets[userId]
	if userBuckets == nil then
		userBuckets = {}
		rateBuckets[userId] = userBuckets
	end
	local b = userBuckets[action]
	if b == nil then
		b = RemoteValidation.newBucket()
		userBuckets[action] = b
	end
	return b
end

local function rateOk(player: Player, action: string): boolean
	return RemoteValidation.checkRate(getBucket(player.UserId, action), os.clock(), 2, 12)
end

local function pushProfile(player: Player)
	local session = ProfileService.getSession(player.UserId)
	if not session then
		return
	end
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local ev = remotes:FindFirstChild("ProfileUpdated")
	if ev and ev:IsA("RemoteEvent") then
		ev:FireClient(player, session.profile)
	end
end

function GameServer.setupRemotes()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	local names = { "ProfileUpdated", "RequestAction", "ActionResult" }
	for _, n in names do
		if not folder:FindFirstChild(n) then
			local ev = Instance.new("RemoteEvent")
			ev.Name = n
			ev.Parent = folder
		end
	end
	local request = folder:WaitForChild("RequestAction") :: RemoteEvent
	local result = folder:WaitForChild("ActionResult") :: RemoteEvent

	request.OnServerEvent:Connect(function(player, action: any, payload: any)
		if not rateOk(player, "RequestAction") then
			return
		end
		if type(action) ~= "string" then
			return
		end
		local session = ProfileService.getSession(player.UserId)
		if not session then
			return
		end
		local profile = session.profile
		local ok = false

		if action == "set_language" then
			local lang = RemoteValidation.validateEnum(payload, { "ru", "uk", "en", "da" })
			if lang then
				profile.language = lang
				ok = true
			end
		elseif action == "set_avatar" then
			local preset = RemoteValidation.validateString(payload, 32)
			if preset then
				profile.avatarPreset = preset
				if QuestEngine.stepExpectsEvent(profile.story, "ch0_avatar_chosen") then
					ok = StoryHandlers.handleEvent(profile, "ch0_avatar_chosen")
				else
					ok = true
				end
			end
		elseif action == "quest_event" then
			local eventId = RemoteValidation.validateString(payload, 64)
			if eventId then
				ok = StoryHandlers.handleEvent(profile, eventId)
			end
		elseif action == "house_zone" then
			local zone = RemoteValidation.validateString(payload, 32)
			if zone then
				ok = StoryHandlers.handleHouseZone(profile, zone)
			end
		elseif action == "initiation_choice" then
			local path = RemoteValidation.validateString(payload, 16)
			if path then
				ok = StoryHandlers.handleInitiationChoice(profile, path)
			end
		elseif action == "cemetery_job" then
			ok = StoryHandlers.handleCemeteryJob(profile)
		elseif action == "duel_win" then
			ok = StoryHandlers.handleDuelWin(profile)
		elseif action == "flyers_done" then
			ok = StoryHandlers.handleFlyersDone(profile)
		elseif action == "hangout_stage" then
			ok = StoryHandlers.handleHangoutStage(profile)
		elseif action == "ch2_antibully" then
			local choice = RemoteValidation.validateString(payload, 16)
			if choice then
				ok = StoryHandlers.handleCh2Antibully(profile, choice)
			end
		elseif action == "ch3_ghost" then
			ok = StoryHandlers.handleCh3Ghost(profile)
		elseif action == "ch3_crypt" then
			ok = StoryHandlers.handleCh3Crypt(profile)
		elseif action == "bell_tongue" then
			local branch = RemoteValidation.validateString(payload, 16)
			if branch then
				ok = StoryHandlers.handleBellTongue(profile, branch)
			end
		elseif action == "ch4_stage" then
			local stage = RemoteValidation.validateString(payload, 16)
			if stage then
				ok = StoryHandlers.handleCh4Stub(profile, stage)
			end
		elseif action == "pick_ending" then
			local endingId = RemoteValidation.validateString(payload, 40)
			if endingId then
				ok = StoryHandlers.handleEnding(profile, endingId)
			end
		elseif action == "pay_initiation" then
			ok = StoryHandlers.handleEvent(profile, "event:pay_initiation_fee")
		end

		if ok then
			ProfileService.saveSession(session)
			pushProfile(player)
			result:FireClient(player, { ok = true })
		else
			result:FireClient(player, { ok = false })
		end
	end)
end

function GameServer.onPlayerAdded(player: Player)
	local session, err = ProfileService.startSession(player.UserId)
	if not session then
		player:Kick("Save load failed: " .. tostring(err))
		return
	end
	pushProfile(player)
end

function GameServer.onPlayerRemoving(player: Player)
	local session = ProfileService.getSession(player.UserId)
	if session then
		ProfileService.saveSession(session)
	end
	ProfileService.endSession(player.UserId)
	rateBuckets[player.UserId] = nil
end

function GameServer.start()
	MonetizationService.bind()
	local worldFolder = workspace:WaitForChild("World") :: Folder
	WorldBuilder.build(worldFolder)
	GameServer.setupRemotes()
	Players.PlayerAdded:Connect(GameServer.onPlayerAdded)
	Players.PlayerRemoving:Connect(GameServer.onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(GameServer.onPlayerAdded, p)
	end
end

return GameServer
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="21">
      <Properties>
        <string name="Name">MonetizationService</string>
        <string name="Source"><![CDATA[--!strict
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReceiptStore = require(game.ReplicatedStorage.Shared.ReceiptStore)
local DataStoreScope = require(game.ReplicatedStorage.Shared.DataStoreScope)
local DevProducts = require(game.ReplicatedStorage.Config.DevProducts)

local MonetizationService = {}

local RECEIPT_BASE = "PunkMeAngel_Receipts_v1"
local memoryReceipts: { [string]: boolean } = {}

local function receiptDatastore(): GlobalDataStore
	local name = DataStoreScope.receiptStoreName(RECEIPT_BASE, RunService:IsStudio(), nil)
	return DataStoreService:GetDataStore(name)
end

function MonetizationService.processReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local purchaseId = receiptInfo.PurchaseId
	local productId = receiptInfo.ProductId
	if purchaseId == nil or productId == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local store = receiptDatastore()
	local key = "r_" .. purchaseId
	local already = false
	pcall(function()
		already = store:GetAsync(key) == true
	end)
	if already or ReceiptStore.wasProcessed(memoryReceipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local result = ReceiptStore.fulfill(memoryReceipts, purchaseId, productId, DevProducts.TEST_PRODUCTS)
	if result == "unknown_product" then
		warn("[Monetization] Unknown test product", productId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	pcall(function()
		store:SetAsync(key, true)
	end)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.bind()
	MarketplaceService.ProcessReceipt = MonetizationService.processReceipt
end

return MonetizationService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="22">
      <Properties>
        <string name="Name">ProfileService</string>
        <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ProfileSchema = require(game.ReplicatedStorage.Shared.ProfileSchema)
local ProfileMigrator = require(game.ReplicatedStorage.Shared.ProfileMigrator)
local DataStoreScope = require(game.ReplicatedStorage.Shared.DataStoreScope)

local ProfileService = {}
ProfileService.__index = ProfileService

export type Session = {
	profile: ProfileSchema.Profile,
	locked: boolean,
	userId: number,
}

local STORE_BASE = "PunkMeAngel_Profile_v1"
local MAX_RETRIES = 5
local RETRY_PAUSE = 1

local activeSessions: { [number]: Session } = {}

local function getStore(): GlobalDataStore
	local name = DataStoreScope.profileStoreName(STORE_BASE, RunService:IsStudio(), nil)
	return DataStoreService:GetDataStore(name)
end

local function keyForUser(userId: number): string
	return "player_" .. tostring(userId)
end

local function withRetry<T>(fn: () -> T): (T?, string?)
	local lastErr: string? = nil
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return result, nil
		end
		lastErr = tostring(result)
		task.wait(RETRY_PAUSE * attempt)
	end
	return nil, lastErr
end

function ProfileService.load(userId: number): (ProfileSchema.Profile?, string?)
	local store = getStore()
	local k = keyForUser(userId)
	local loaded, loadErr = withRetry(function()
		return store:GetAsync(k)
	end)
	if loadErr and loaded == nil then
		return nil, "load_failed"
	end
	if ProfileSchema.isEmptyProfile(loaded) then
		return ProfileSchema.defaultProfile(), nil
	end
	local migrated, migrateErr = ProfileMigrator.migrate(loaded)
	if not migrated then
		-- Never overwrite existing cloud data with empty defaults on parse failure
		return nil, migrateErr or "migrate_failed"
	end
	return migrated, nil
end

function ProfileService.startSession(userId: number): (Session?, string?)
	if activeSessions[userId] then
		return activeSessions[userId], nil
	end
	local profile, err = ProfileService.load(userId)
	if not profile then
		return nil, err
	end
	local session: Session = {
		profile = profile,
		locked = true,
		userId = userId,
	}
	activeSessions[userId] = session
	return session, nil
end

function ProfileService.saveSession(session: Session): (boolean, string?)
	local store = getStore()
	local k = keyForUser(session.userId)
	local toSave = session.profile
	local _, saveErr = withRetry(function()
		store:UpdateAsync(k, function(old)
			if ProfileSchema.isEmptyProfile(old) and toSave == nil then
				return nil
			end
			return toSave
		end)
		return true
	end)
	if saveErr then
		return false, saveErr or "save_failed"
	end
	return true, nil
end

function ProfileService.endSession(userId: number)
	activeSessions[userId] = nil
end

function ProfileService.getSession(userId: number): Session?
	return activeSessions[userId]
end

return ProfileService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="23">
      <Properties>
        <string name="Name">StoryHandlers</string>
        <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local QuestEngine = require(ReplicatedStorage.Shared.QuestEngine)
local ProfileSchema = require(ReplicatedStorage.Shared.ProfileSchema)
local QuestTable = require(ReplicatedStorage.Config.QuestTable)

local StoryHandlers = {}

local function applyGrants(profile: ProfileSchema.Profile, grant: QuestEngine.GrantResult)
	if grant.granted then
		profile.coins += grant.coinsDelta
		if grant.xpDelta > 0 then
			profile.xp, profile.level = Economy.applyXp(profile.xp + grant.xpDelta, profile.level)
		end
	end
end

function StoryHandlers.handleEvent(profile: ProfileSchema.Profile, eventId: string): boolean
	local story = profile.story
	if eventId == "event:pay_initiation_fee" then
		if profile.coins < 150 then
			return false
		end
		profile.coins -= 150
	end
	local ok, grant = QuestEngine.trySpecial(story, eventId, { coins = profile.coins })
	if not ok then
		return false
	end
	if grant then
		applyGrants(profile, grant)
	end
	return true
end

function StoryHandlers.handleInitiationChoice(profile: ProfileSchema.Profile, path: string): boolean
	if path ~= "pay" and path ~= "duel" and path ~= "graffiti" then
		return false
	end
	return QuestEngine.pickInitiationPath(profile.story, path :: "pay" | "duel" | "graffiti")
end

function StoryHandlers.handleCemeteryJob(profile: ProfileSchema.Profile): boolean
	local story = profile.story
	if story.activeQuestId == "q_initiation_pay" and story.activeStepId == "s1" then
		local key = "job_cemetery_ch1"
		local newCoins, granted, _ = Economy.payJobReward(profile.coins, 65, key, story.grantedRewards)
		if granted then
			story.grantedRewards[key] = true
			profile.coins = newCoins
			QuestEngine.trySpecial(story, "coins>=150", { coins = profile.coins })
			return true
		end
	end
	if story.activeQuestId == QuestTable.CH3 and story.activeStepId == "ch3_s_job" then
		local key = "job_ch3_cemetery"
		local newCoins, granted, _ = Economy.payJobReward(profile.coins, 70, key, story.grantedRewards)
		if granted then
			story.grantedRewards[key] = true
			profile.coins = newCoins
			return QuestEngine.tryCompleteEvent(story, "ch3_cemetery_shift")
		end
	end
	return false
end

function StoryHandlers.handleDuelWin(profile: ProfileSchema.Profile): boolean
	local story = profile.story
	if story.activeQuestId == "q_initiation_duel" then
		local ok, grant = QuestEngine.tryCompleteEvent(story, "event:duel_razor_win")
		if ok then
			if grant then
				applyGrants(profile, grant)
			end
			return true
		end
	end
	return false
end

function StoryHandlers.handleFlyersDone(profile: ProfileSchema.Profile): boolean
	if profile.story.activeQuestId == "q_initiation_graffiti" then
		local ok, grant = QuestEngine.tryCompleteEvent(profile.story, "event:flyers_done")
		if ok then
			if grant then
				applyGrants(profile, grant)
			end
			return true
		end
	end
	return false
end

function StoryHandlers.handleHangoutStage(profile: ProfileSchema.Profile): boolean
	local story = profile.story
	if story.activeQuestId ~= QuestTable.CH2 then
		return false
	end
	story.hangoutStage = math.min(4, story.hangoutStage + 1)
	if story.hangoutStage >= 4 then
		local ok, grant = QuestEngine.trySpecial(story, "hangout_stage>=4", nil)
		if grant then
			applyGrants(profile, grant)
		end
		return ok
	end
	return true
end

function StoryHandlers.handleCh2Antibully(profile: ProfileSchema.Profile, choice: string): boolean
	if choice ~= "stand" and choice ~= "join" then
		return false
	end
	QuestEngine.setDecision(profile.story, "ch2_bully", choice)
	if choice == "stand" then
		profile.story.relationships.razor = (profile.story.relationships.razor or 0) + 10
	else
		profile.story.relationships.cobalt = (profile.story.relationships.cobalt or 0) - 5
	end
	if profile.story.activeQuestId == "q_ch2_antibully" then
		QuestEngine.tryCompleteEvent(profile.story, "ch2_antibully_resolved")
		local g = QuestEngine.grantReward(profile.story, "reward_ch2_choice")
		applyGrants(profile, g)
	end
	return true
end

function StoryHandlers.handleCh3Ghost(profile: ProfileSchema.Profile): boolean
	if profile.story.activeQuestId == QuestTable.CH3 and profile.story.activeStepId == "ch3_s_ghost" then
		return QuestEngine.tryCompleteEvent(profile.story, "ch3_ghost_helped")
	end
	return false
end

function StoryHandlers.handleCh3Crypt(profile: ProfileSchema.Profile): boolean
	if profile.story.activeQuestId == QuestTable.CH3 and profile.story.activeStepId == "ch3_s_crypt" then
		local ok, grant = QuestEngine.tryCompleteEvent(profile.story, "ch3_crypt_built")
		if ok then
			if grant then
				applyGrants(profile, grant)
			end
			return true
		end
	end
	return false
end

function StoryHandlers.handleBellTongue(profile: ProfileSchema.Profile, branch: string): boolean
	if branch == "zoya" then
		if profile.story.uniqueItems.bell_tongue_zombie then
			return false
		end
		if QuestEngine.grantUniqueItem(profile.story, "bell_tongue_zoya") then
			return QuestEngine.tryCompleteEvent(profile.story, "ch4_tongue_obtained")
		end
	elseif branch == "zombie" then
		if profile.story.uniqueItems.bell_tongue_zoya then
			return false
		end
		if QuestEngine.grantUniqueItem(profile.story, "bell_tongue_zombie") then
			return QuestEngine.tryCompleteEvent(profile.story, "ch4_tongue_obtained")
		end
	end
	return false
end

function StoryHandlers.handleCh4Stub(profile: ProfileSchema.Profile, stage: string): boolean
	local story = profile.story
	if story.activeQuestId ~= QuestTable.CH4 then
		return false
	end
	if stage == "crown" and story.activeStepId == "ch4_s_crown" then
		QuestEngine.grantUniqueItem(story, "bell_crown")
		return QuestEngine.tryCompleteEvent(story, "ch4_crown_obtained")
	end
	if stage == "concert" and story.activeStepId == "ch4_s_concert" then
		return QuestEngine.tryCompleteEvent(story, "ch4_concert_ready")
	end
	return false
end

function StoryHandlers.handleEnding(profile: ProfileSchema.Profile, endingId: string): boolean
	if QuestEngine.pickEnding(profile.story, endingId) then
		local ending = QuestTable.endings[endingId]
		if ending then
			local g = QuestEngine.grantReward(profile.story, ending.grantKey)
			applyGrants(profile, g)
		end
		return true
	end
	return false
end

function StoryHandlers.handleHouseZone(profile: ProfileSchema.Profile, zoneId: string): boolean
	local story = profile.story
	if story.activeStepId ~= "ch0_s_house" then
		return false
	end
	story.ch0HouseZones[zoneId] = true
	local count = 0
	for _, v in story.ch0HouseZones do
		if v then
			count += 1
		end
	end
	if count >= 2 then
		return QuestEngine.tryCompleteEvent(story, "ch0_house_tour")
	end
	return false
end

return StoryHandlers
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="24">
      <Properties>
        <string name="Name">WorldBuilder</string>
        <string name="Source"><![CDATA[--!strict
local WorldBuilder = {}

local function makePart(props: {
	Name: string,
	Size: Vector3,
	Position: Vector3,
	Color: Color3,
	Parent: Instance,
	Anchored: boolean?,
}): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Size = props.Size
	p.Position = props.Position
	p.Color = props.Color
	p.Anchored = if props.Anchored == nil then true else props.Anchored
	p.Material = Enum.Material.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.Parent
	return p
end

local function addZone(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3)
	local z = makePart({
		Name = name,
		Size = size,
		Position = position,
		Color = color,
		Parent = parent,
	})
	z.Transparency = 0.85
	z.CanCollide = false
	z:SetAttribute("ZoneId", name)
	return z
end

local function addSpawn(parent: Instance, name: string, position: Vector3)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = name
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = position
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = parent
end

local function addNpc(parent: Instance, name: string, position: Vector3, color: Color3, action: string?)
	local root = makePart({
		Name = name,
		Size = Vector3.new(2, 5, 2),
		Position = position + Vector3.new(0, 2.5, 0),
		Color = color,
		Parent = parent,
	})
	root:SetAttribute("NpcId", name)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action or "Talk"
	prompt.ObjectText = name
	prompt.MaxActivationDistance = 12
	prompt.Parent = root
end

function WorldBuilder.build(parent: Folder)
	parent:ClearAllChildren()

	local house = Instance.new("Folder")
	house.Name = "House13"
	house.Parent = parent
	makePart({
		Name = "Floor",
		Size = Vector3.new(40, 1, 40),
		Position = Vector3.new(0, 0, 0),
		Color = Color3.fromRGB(55, 50, 60),
		Parent = house,
	})
	addZone(house, "zone_room", Vector3.new(18, 8, 18), Vector3.new(-12, 4, -12), Color3.fromRGB(120, 80, 200))
	addZone(house, "zone_hall", Vector3.new(20, 8, 20), Vector3.new(8, 4, 0), Color3.fromRGB(80, 120, 200))
	makePart({
		Name = "marker_move",
		Size = Vector3.new(4, 1, 4),
		Position = Vector3.new(15, 1, 0),
		Color = Color3.fromRGB(255, 220, 80),
		Parent = house,
	})
	addSpawn(house, "SpawnHouse", Vector3.new(-5, 3, -5))
	addNpc(house, "npc_mom", Vector3.new(18, 0, 8), Color3.fromRGB(180, 120, 140), "Talk")
	addNpc(house, "npc_shnurok", Vector3.new(-18, 0, -8), Color3.fromRGB(140, 100, 60), "Pet")

	local street = Instance.new("Folder")
	street.Name = "Street"
	street.Parent = parent
	makePart({
		Name = "StreetFloor",
		Size = Vector3.new(60, 1, 30),
		Position = Vector3.new(80, 0, 0),
		Color = Color3.fromRGB(45, 45, 50),
		Parent = street,
	})
	addZone(street, "zone_street", Vector3.new(55, 10, 28), Vector3.new(80, 5, 0), Color3.fromRGB(255, 100, 180))
	addNpc(street, "npc_razor", Vector3.new(70, 0, 5), Color3.fromRGB(30, 30, 35))
	makePart({
		Name = "Shop",
		Size = Vector3.new(14, 10, 14),
		Position = Vector3.new(100, 5, -10),
		Color = Color3.fromRGB(90, 40, 120),
		Parent = street,
	})

	local cemetery = Instance.new("Folder")
	cemetery.Name = "Cemetery"
	cemetery.Parent = parent
	makePart({
		Name = "CemeteryGround",
		Size = Vector3.new(50, 1, 50),
		Position = Vector3.new(0, 0, 120),
		Color = Color3.fromRGB(35, 50, 40),
		Parent = cemetery,
	})
	addNpc(cemetery, "npc_gravedigger", Vector3.new(-5, 0, 125), Color3.fromRGB(60, 55, 45), "Work")
	addNpc(cemetery, "npc_ghost", Vector3.new(10, 0, 130), Color3.fromRGB(200, 180, 255), "Help")
	local crypt = makePart({
		Name = "obj_crypt_site",
		Size = Vector3.new(12, 2, 12),
		Position = Vector3.new(-15, 1, 140),
		Color = Color3.fromRGB(50, 45, 55),
		Parent = cemetery,
	})
	local cp = Instance.new("ProximityPrompt")
	cp.ActionText = "Build"
	cp.ObjectText = "Crypt"
	cp.MaxActivationDistance = 14
	cp.Parent = crypt

	local construction = Instance.new("Folder")
	construction.Name = "Construction"
	construction.Parent = parent
	local hangout = makePart({
		Name = "obj_hangout_site",
		Size = Vector3.new(20, 2, 20),
		Position = Vector3.new(80, 0, 80),
		Color = Color3.fromRGB(70, 70, 90),
		Parent = construction,
	})
	local hp = Instance.new("ProximityPrompt")
	hp.ActionText = "Build"
	hp.ObjectText = "Hangout"
	hp.MaxActivationDistance = 14
	hp.Parent = hangout

	local duel = Instance.new("Folder")
	duel.Name = "DuelPit"
	duel.Parent = parent
	local arena = makePart({
		Name = "zone_duel",
		Size = Vector3.new(24, 1, 24),
		Position = Vector3.new(120, 0, 120),
		Color = Color3.fromRGB(80, 30, 30),
		Parent = duel,
	})
	arena:SetAttribute("ZoneId", "zone_duel")

	local castle = Instance.new("Folder")
	castle.Name = "Castle"
	castle.Parent = parent
	makePart({
		Name = "zone_castle_hall",
		Size = Vector3.new(30, 1, 30),
		Position = Vector3.new(-80, 0, 80),
		Color = Color3.fromRGB(60, 40, 80),
		Parent = castle,
	})
	makePart({
		Name = "zone_castle_tower",
		Size = Vector3.new(10, 20, 10),
		Position = Vector3.new(-95, 10, 95),
		Color = Color3.fromRGB(50, 35, 70),
		Parent = castle,
	})
	addNpc(castle, "npc_count", Vector3.new(-80, 0, 80), Color3.fromRGB(90, 70, 120))
	addNpc(castle, "npc_zoya", Vector3.new(-65, 0, 70), Color3.fromRGB(200, 140, 80), "Talk")

	local parkour = Instance.new("Folder")
	parkour.Name = "Parkour"
	parkour.Parent = parent
	local px = 160
	for i = 1, 6 do
		makePart({
			Name = "Step" .. i,
			Size = Vector3.new(6, 2, 6),
			Position = Vector3.new(px + i * 8, i * 3, 40),
			Color = Color3.fromRGB(255, 180, 60),
			Parent = parkour,
		})
	end
end

return WorldBuilder
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="25">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  </Item>
  <Item class="SoundService" referent="26">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="27">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="29">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="30">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AngelinaLines = require(ReplicatedStorage.Shared.AngelinaLines)
local AvatarPresets = require(ReplicatedStorage.Config.AvatarPresets)
local QuestTable = require(ReplicatedStorage.Config.QuestTable)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local profile: any = nil
local lookedRoom = false
local interactDone = false

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local profileUpdated = remotes:WaitForChild("ProfileUpdated") :: RemoteEvent
local requestAction = remotes:WaitForChild("RequestAction") :: RemoteEvent

local screen = Instance.new("ScreenGui")
screen.Name = "PunkMeHUD"
screen.ResetOnSpawn = false
screen.Parent = playerGui

local questLabel = Instance.new("TextLabel")
questLabel.Size = UDim2.new(0, 360, 0, 72)
questLabel.Position = UDim2.new(0, 10, 0, 10)
questLabel.BackgroundTransparency = 0.25
questLabel.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
questLabel.TextColor3 = Color3.new(1, 1, 1)
questLabel.TextWrapped = true
questLabel.Font = Enum.Font.GothamBold
questLabel.TextSize = 15
questLabel.Parent = screen

local coinsLabel = Instance.new("TextLabel")
coinsLabel.Size = UDim2.new(0, 180, 0, 28)
coinsLabel.Position = UDim2.new(0, 10, 0, 88)
coinsLabel.BackgroundTransparency = 0.2
coinsLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
coinsLabel.Font = Enum.Font.GothamBold
coinsLabel.TextSize = 16
coinsLabel.Parent = screen

local angelinaFrame = Instance.new("Frame")
angelinaFrame.Size = UDim2.new(0, 300, 0, 110)
angelinaFrame.Position = UDim2.new(1, -310, 1, -120)
angelinaFrame.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
angelinaFrame.Parent = screen

local angelinaText = Instance.new("TextLabel")
angelinaText.Size = UDim2.new(1, -10, 1, -36)
angelinaText.Position = UDim2.new(0, 5, 0, 4)
angelinaText.BackgroundTransparency = 1
angelinaText.TextColor3 = Color3.fromRGB(240, 220, 255)
angelinaText.TextWrapped = true
angelinaText.TextXAlignment = Enum.TextXAlignment.Left
angelinaText.Font = Enum.Font.Gotham
angelinaText.TextSize = 14
angelinaText.Parent = angelinaFrame

local helpBtn = Instance.new("TextButton")
helpBtn.Size = UDim2.new(0, 90, 0, 28)
helpBtn.Position = UDim2.new(0, 5, 1, -32)
helpBtn.Text = "Помоги"
helpBtn.Parent = angelinaFrame

local picker = Instance.new("Frame")
picker.Size = UDim2.new(0, 280, 0, 220)
picker.Position = UDim2.new(0.5, -140, 0.5, -110)
picker.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
picker.Visible = false
picker.Parent = screen

for i, preset in AvatarPresets.list do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 36)
	btn.Position = UDim2.new(0, 10, 0, 10 + (i - 1) * 42)
	btn.Text = preset.id
	btn.Parent = picker
	btn.MouseButton1Click:Connect(function()
		requestAction:FireServer("set_avatar", preset.id)
		picker.Visible = false
	end)
end

local choiceFrame = Instance.new("Frame")
choiceFrame.Size = UDim2.new(0, 300, 0, 120)
choiceFrame.Position = UDim2.new(0.5, -150, 0.7, 0)
choiceFrame.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
choiceFrame.Visible = false
choiceFrame.Parent = screen

local function lang(): AngelinaLines.Lang
	if profile and profile.language then
		return profile.language
	end
	return "ru"
end

local function say(ctx: AngelinaLines.Context)
	angelinaText.Text = AngelinaLines.forContext(ctx, lang())
end

local function refreshQuest()
	if not profile or not profile.story then
		return
	end
	local st = profile.story
	local step = QuestTable.stepDef(st.activeQuestId, st.activeStepId)
	if step then
		questLabel.Text = step.objective[lang()] or step.objective.en or st.activeStepId
		if step.angelina then
			say(step.angelina :: AngelinaLines.Context)
		end
	else
		questLabel.Text = st.activeQuestId .. " / " .. st.activeStepId
	end
	coinsLabel.Text = "🪙 " .. tostring(profile.coins)
	if st.activeStepId == "ch0_s_avatar" then
		picker.Visible = true
	end
	if st.activeStepId == "ch1_s_choice" then
		choiceFrame.Visible = true
	end
end

profileUpdated.OnClientEvent:Connect(function(p)
	profile = p
	refreshQuest()
end)

helpBtn.MouseButton1Click:Connect(function()
	say("stuck")
end)

task.delay(1.5, function()
	if not lookedRoom then
		lookedRoom = true
		requestAction:FireServer("quest_event", "ch0_look_room")
	end
end)

local endingFrame = Instance.new("Frame")
endingFrame.Size = UDim2.new(0, 320, 0, 140)
endingFrame.Position = UDim2.new(0.5, -160, 0.55, 0)
endingFrame.BackgroundColor3 = Color3.fromRGB(25, 10, 35)
endingFrame.Visible = false
endingFrame.Parent = screen

for id, def in QuestTable.endings do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -12, 0, 36)
	b.Text = def.title.ru
	b.Parent = endingFrame
	b.MouseButton1Click:Connect(function()
		requestAction:FireServer("pick_ending", id)
		endingFrame.Visible = false
	end)
end

local function bindPrompt(prompt: ProximityPrompt)
	if prompt:GetAttribute("Bound") then
		return
	end
	prompt:SetAttribute("Bound", true)
	prompt.Triggered:Connect(function()
		if not profile or not profile.story then
			return
		end
		local st = profile.story
		local parent = prompt.Parent
		local npcId = parent and parent:GetAttribute("NpcId")
		if not interactDone then
			interactDone = true
			requestAction:FireServer("quest_event", "ch0_interact_done")
		end
		if npcId == "npc_mom" then
			requestAction:FireServer("quest_event", "ch0_mom_talk")
		elseif npcId == "npc_shnurok" then
			requestAction:FireServer("quest_event", "ch0_pet_shnurok")
		elseif npcId == "npc_razor" then
			if st.activeStepId == "ch0_s_razor" then
				requestAction:FireServer("quest_event", "ch0_razor_talk")
			elseif st.activeQuestId == "q_initiation_pay" and st.activeStepId == "s2" then
				requestAction:FireServer("pay_initiation")
			elseif st.activeQuestId == "q_initiation_duel" then
				requestAction:FireServer("duel_win")
			elseif st.activeQuestId == "q_initiation_graffiti" then
				requestAction:FireServer("flyers_done")
			end
		elseif npcId == "npc_gravedigger" then
			requestAction:FireServer("cemetery_job")
		elseif npcId == "npc_ghost" then
			requestAction:FireServer("ch3_ghost")
		elseif npcId == "npc_zoya" then
			requestAction:FireServer("bell_tongue", "zoya")
		elseif npcId == "npc_count" and st.activeStepId == "ch4_s_ending" then
			endingFrame.Visible = true
		end
		local on = parent and parent.Name
		if on == "obj_hangout_site" then
			requestAction:FireServer("hangout_stage")
		elseif on == "obj_crypt_site" then
			requestAction:FireServer("ch3_crypt")
		end
	end)
end

workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("ProximityPrompt") then
		bindPrompt(inst)
	end
end)
for _, inst in workspace:GetDescendants() do
	if inst:IsA("ProximityPrompt") then
		bindPrompt(inst)
	end
end

local function addChoice(text: string, action: string, payload: string?)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -16, 0, 32)
	b.Position = UDim2.new(0, 8, 0, 8 + #choiceFrame:GetChildren() * 36)
	b.Text = text
	b.Parent = choiceFrame
	b.MouseButton1Click:Connect(function()
		requestAction:FireServer(action, payload)
		choiceFrame.Visible = false
	end)
end

addChoice("Взнос 150", "initiation_choice", "pay")
addChoice("Дуэль", "initiation_choice", "duel")
addChoice("Флаеры", "initiation_choice", "graffiti")

profileUpdated.OnClientEvent:Connect(function(p)
	if p.story and p.story.activeStepId == "ch4_s_ending" then
		endingFrame.Visible = true
	end
end)

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp or not profile or not profile.story then
		return
	end
	local st = profile.story
	if st.activeStepId == "ch0_s_move" then
		local marker = workspace:FindFirstChild("World", true)
		local house = marker and workspace.World:FindFirstChild("House13")
		local m = house and house:FindFirstChild("marker_move") :: BasePart?
		if m and (hrp.Position - m.Position).Magnitude < 8 then
			requestAction:FireServer("quest_event", "ch0_move_done")
		end
	end
	if st.activeStepId == "ch0_s_street" and hrp.Position.X > 55 then
		requestAction:FireServer("quest_event", "ch0_enter_street")
	end
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("BasePart") and inst:GetAttribute("ZoneId") then
			local zoneId = inst:GetAttribute("ZoneId") :: string
			local rel = hrp.Position - inst.Position
			if
				math.abs(rel.X) < inst.Size.X / 2
				and math.abs(rel.Y) < inst.Size.Y / 2
				and math.abs(rel.Z) < inst.Size.Z / 2
			then
				if zoneId == "zone_room" or zoneId == "zone_hall" then
					requestAction:FireServer("house_zone", zoneId)
				end
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="31">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">World</string>
      </Properties>
    </Item>
  </Item>
</roblox>