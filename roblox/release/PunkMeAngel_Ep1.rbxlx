      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">DuelEngine</string>
          <string name="Source"><![CDATA[--!strict
local DuelEngine = {}

export type Action = "attack" | "block" | "dodge"
export type Phase = "fighting" | "player_win" | "player_lose"

export type State = {
	playerHp: number,
	opponentHp: number,
	phase: Phase,
	round: number,
	lastNpcAction: Action?,
}

local MAX_HP = 100
local DAMAGE = 18
local BLOCKED_DAMAGE = 4

function DuelEngine.newState(): State
	return {
		playerHp = MAX_HP,
		opponentHp = MAX_HP,
		phase = "fighting",
		round = 0,
		lastNpcAction = nil,
	}
end

local function npcActionForRound(round: number): Action
	local pattern: { Action } = { "attack", "attack", "block", "dodge" }
	return pattern[(round % #pattern) + 1]
end

function DuelEngine.resolveTurn(state: State, playerAction: Action): (State, { hitPlayer: boolean, hitNpc: boolean })
	if state.phase ~= "fighting" then
		return state, { hitPlayer = false, hitNpc = false }
	end
	local npcAction = npcActionForRound(state.round)
	local hitPlayer = false
	local hitNpc = false

	if playerAction == "attack" and npcAction ~= "dodge" then
		if npcAction == "block" then
			state.opponentHp = math.max(0, state.opponentHp - BLOCKED_DAMAGE)
			hitNpc = true
		else
			state.opponentHp = math.max(0, state.opponentHp - DAMAGE)
			hitNpc = true
		end
	end

	if npcAction == "attack" and playerAction ~= "dodge" then
		if playerAction == "block" then
			state.playerHp = math.max(0, state.playerHp - BLOCKED_DAMAGE)
			hitPlayer = true
		else
			state.playerHp = math.max(0, state.playerHp - DAMAGE)
			hitPlayer = true
		end
	end

	state.round += 1
	state.lastNpcAction = npcAction

	if state.opponentHp <= 0 then
		state.phase = "player_win"
	elseif state.playerHp <= 0 then
		state.phase = "player_lose"
	end

	return state, { hitPlayer = hitPlayer, hitNpc = hitNpc }
end

return DuelEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
local Economy = {}

export type ShopItem = {
	id: string,
	price: number,
	category: string,
	grantInventoryKey: string?,
}

export type PurchaseResult = { ok: true, newBalance: number } | {
	ok: false,
	reason: "insufficient_funds" | "unknown_item" | "already_owned",
	need: number?,
}

function Economy.tryPurchase(coins: number, item: ShopItem?, alreadyOwned: boolean): PurchaseResult
	if item == nil then
		return { ok = false, reason = "unknown_item" }
	end
	if alreadyOwned and item.grantInventoryKey ~= nil then
		return { ok = false, reason = "already_owned" }
	end
	if coins < item.price then
		return { ok = false, reason = "insufficient_funds", need = item.price - coins }
	end
	return { ok = true, newBalance = coins - item.price }
end

function Economy.payJobReward(
	coins: number,
	amount: number,
	grantKey: string,
	granted: { [string]: boolean }
): (number, boolean, string?)
	if amount <= 0 then
		return coins, false, "invalid_amount"
	end
	if granted[grantKey] then
		return coins, false, "already_granted"
	end
	return coins + amount, true, nil
end

function Economy.xpForLevel(level: number): number
	return 50 + (level - 1) * 25
end

function Economy.applyXp(xp: number, level: number): (number, number)
	local newXp = xp
	local newLevel = level
	while newXp >= Economy.xpForLevel(newLevel) do
		newXp -= Economy.xpForLevel(newLevel)
		newLevel += 1
	end
	return newXp, newLevel
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">EndingLogic</string>
          <string name="Source"><![CDATA[--!strict
local EndingLogic = {}

export type EndingId = "ending_break_curse" | "ending_zombie_style" | "ending_count_deal"

function EndingLogic.recommended(story: {
	relationships: { [string]: number },
	decisions: { [string]: string },
	concertHeadliner: string?,
}): EndingId
	local razor = story.relationships.razor or 0
	local count = story.relationships.count or 0
	local bully = story.decisions.ch2_bully
	if count >= 15 and (story.concertHeadliner == "count" or story.concertHeadliner == "ghost") then
		return "ending_count_deal"
	end
	if bully == "join" or razor < 5 then
		return "ending_zombie_style"
	end
	return "ending_break_curse"
end

function EndingLogic.canPick(
	story: { relationships: { [string]: number }, decisions: { [string]: string } },
	endingId: EndingId
): boolean
	if endingId == "ending_break_curse" then
		return (story.relationships.razor or 0) >= 0
	end
	if endingId == "ending_zombie_style" then
		return true
	end
	if endingId == "ending_count_deal" then
		return (story.relationships.count or 0) >= 10
	end
	return false
end

return EndingLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">FlyerEngine</string>
          <string name="Source"><![CDATA[--!strict
local FlyerEngine = {}

FlyerEngine.SPOT_IDS = {
	"flyer_street_1",
	"flyer_street_2",
	"flyer_street_3",
	"flyer_city_1",
	"flyer_city_2",
	"flyer_city_3",
	"flyer_cemetery_gate",
	"flyer_shop_wall",
}

function FlyerEngine.newProgress(): { [string]: boolean }
	return {}
end

function FlyerEngine.postSpot(progress: { [string]: boolean }, spotId: string): (boolean, number)
	if progress[spotId] then
		return false, FlyerEngine.count(progress)
	end
	local valid = false
	for _, id in FlyerEngine.SPOT_IDS do
		if id == spotId then
			valid = true
			break
		end
	end
	if not valid then
		return false, FlyerEngine.count(progress)
	end
	progress[spotId] = true
	return true, FlyerEngine.count(progress)
end

function FlyerEngine.count(progress: { [string]: boolean }): number
	local n = 0
	for _, id in FlyerEngine.SPOT_IDS do
		if progress[id] then
			n += 1
		end
	end
	return n
end

function FlyerEngine.isComplete(progress: { [string]: boolean }): boolean
	return FlyerEngine.count(progress) >= #FlyerEngine.SPOT_IDS
end

return FlyerEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">GhostRiddleEngine</string>
          <string name="Source"><![CDATA[--!strict
local GhostRiddleEngine = {}

GhostRiddleEngine.RIDDLE_COUNT = 3

-- Answers are lowercase keywords (non-violent lore: bell, crypt path, Vienna)
GhostRiddleEngine.ANSWERS = { "колокол", "склеп", "вена" }

function GhostRiddleEngine.normalize(answer: string): string
	return string.lower(string.gsub(answer, "^%s+", "")):gsub("%s+$", "")
end

function GhostRiddleEngine.submit(step: number, answer: string): (boolean, number)
	if step < 0 or step >= GhostRiddleEngine.RIDDLE_COUNT then
		return false, step
	end
	local norm = GhostRiddleEngine.normalize(answer)
	if norm ~= GhostRiddleEngine.ANSWERS[step + 1] then
		return false, step
	end
	return true, step + 1
end

function GhostRiddleEngine.isComplete(step: number): boolean
	return step >= GhostRiddleEngine.RIDDLE_COUNT
end

return GhostRiddleEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">HangoutEngine</string>
          <string name="Source"><![CDATA[--!strict
local HangoutEngine = {}

export type StageId = "foundation" | "frame" | "neon" | "grand_open"

HangoutEngine.ORDER = { "foundation", "frame", "neon", "grand_open" }

export type Progress = {
	foundation: boolean,
	frame: boolean,
	neon: boolean,
	grand_open: boolean,
}

function HangoutEngine.newProgress(): Progress
	return { foundation = false, frame = false, neon = false, grand_open = false }
end

function HangoutEngine.stageIndex(stage: StageId): number
	for i, s in HangoutEngine.ORDER do
		if s == stage then
			return i
		end
	end
	return 0
end

function HangoutEngine.canComplete(progress: Progress, stage: StageId): boolean
	if progress[stage] then
		return false
	end
	local idx = HangoutEngine.stageIndex(stage)
	if idx <= 1 then
		return true
	end
	local prev = HangoutEngine.ORDER[idx - 1]
	return progress[prev] == true
end

function HangoutEngine.complete(progress: Progress, stage: StageId): (boolean, number)
	if not HangoutEngine.canComplete(progress, stage) then
		return false, HangoutEngine.completedCount(progress)
	end
	progress[stage] = true
	return true, HangoutEngine.completedCount(progress)
end

function HangoutEngine.completedCount(progress: Progress): number
	local n = 0
	for _, s in HangoutEngine.ORDER do
		if progress[s] then
			n += 1
		end
	end
	return n
end

function HangoutEngine.isDone(progress: Progress): boolean
	return HangoutEngine.completedCount(progress) >= #HangoutEngine.ORDER
end

return HangoutEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">HangoutMinigame</string>
          <string name="Source"><![CDATA[--!strict
local HangoutEngine = if script and script.Parent
	then require(script.Parent.HangoutEngine)
	else require("./HangoutEngine")

export type StageId = HangoutEngine.StageId

local ANSWERS: { [StageId]: string } = {
	foundation = "241",
	frame = "punkframe",
	neon = "neon4",
	grand_open = "tu-sovka",
}

local HangoutMinigame = {
	ANSWERS = ANSWERS,
}

function HangoutMinigame.validate(stage: StageId, answer: string): boolean
	local expected = ANSWERS[stage]
	if expected == nil then
		return false
	end
	return answer == expected
end

return HangoutMinigame
]]></string>
        </Properties>
      </Item>
