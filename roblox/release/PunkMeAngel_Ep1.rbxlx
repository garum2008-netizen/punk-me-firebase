      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">SceneCatalog</string>
          <string name="Source"><![CDATA[--!strict
export type DialogueLine = {
	speaker: string,
	ru: string,
	en: string,
}

export type SceneDef = {
	id: string,
	durationSec: number,
	musicSlot: string?,
	cameraFrom: { x: number, y: number, z: number },
	cameraTo: { x: number, y: number, z: number },
	lookAt: { x: number, y: number, z: number },
	npcIds: { string },
	dialogue: { DialogueLine },
}

local SceneCatalog: { [string]: SceneDef } = {
	scene_ch0_razor = {
		id = "scene_ch0_razor",
		durationSec = 10,
		musicSlot = "ch0_home",
		cameraFrom = { x = 60, y = 8, z = 12 },
		cameraTo = { x = 72, y = 6, z = 8 },
		lookAt = { x = 70, y = 4, z = 5 },
		npcIds = { "npc_razor" },
		dialogue = {
			{
				speaker = "Razor",
				ru = "Ты на улице. Запомни: здесь платят уважением.",
				en = "You're on the street. Remember: respect is the currency.",
			},
			{
				speaker = "Angelina",
				ru = "Он ждёт — поговори, когда будешь готова.",
