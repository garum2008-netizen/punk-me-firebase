      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ProfileMigrator</string>
          <string name="Source"><![CDATA[--!strict
local ProfileSchema = if script and script.Parent
	then require(script.Parent.ProfileSchema)
	else require("./ProfileSchema")

local ProfileMigrator = {}

local function migrateV1ToV2(profile: ProfileSchema.Profile): ProfileSchema.Profile
	profile.schemaVersion = 2
	return profile
end

local function migrateV2ToV3(profile: any): any
	if profile.roomDecor == nil then
		profile.roomDecor = {}
	end
	profile.schemaVersion = 3
	return profile
end

local function migrateV3ToV4(profile: ProfileSchema.Profile): ProfileSchema.Profile
	if profile.story == nil then
		local raw = profile :: any
		local migrated, _ = ProfileSchema.sanitize(raw)
		if migrated then
			return migrated
		end
	end
	profile.schemaVersion = 4
	return profile
end

function ProfileMigrator.migrate(raw: any): (ProfileSchema.Profile?, string?)
	local profile, err = ProfileSchema.sanitize(raw)
	if not profile then
		return nil, err
	end
	while profile.schemaVersion < ProfileSchema.CURRENT_VERSION do
		if profile.schemaVersion < 2 then
			profile = migrateV1ToV2(profile)
		elseif profile.schemaVersion < 3 then
			profile = migrateV2ToV3(profile :: any) :: ProfileSchema.Profile
		elseif profile.schemaVersion < 4 then
			profile = migrateV3ToV4(profile)
		else
			break
		end
	end
	profile.schemaVersion = ProfileSchema.CURRENT_VERSION
	return profile, nil
end

return ProfileMigrator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[--!strict
local QuestEngine = if script and script.Parent then require(script.Parent.QuestEngine) else require("./QuestEngine")

local ProfileSchema = {}

ProfileSchema.CURRENT_VERSION = 4

export type Language = "ru" | "uk" | "en" | "da"

export type Profile = {
	schemaVersion: number,
	coins: number,
	xp: number,
	level: number,
	language: Language,
	avatarPreset: string,
	story: QuestEngine.StoryState,
	inventory: { [string]: number },
	roomDecor: { [string]: boolean },
	settings: {
		musicVolume: number,
		voiceVolume: number,
		sfxVolume: number,
		angelinaHints: boolean,
		subtitles: boolean,
	},
}

local DEFAULT_SETTINGS = {
	musicVolume = 0.7,
	voiceVolume = 1,
	sfxVolume = 0.8,
	angelinaHints = true,
	subtitles = true,
}

function ProfileSchema.defaultProfile(): Profile
	return {
		schemaVersion = ProfileSchema.CURRENT_VERSION,
		coins = 100,
		xp = 0,
		level = 1,
		language = "ru",
		avatarPreset = "",
		story = QuestEngine.defaultStoryState(),
		inventory = {},
		roomDecor = {},
		settings = table.clone(DEFAULT_SETTINGS),
	}
end

local function isLanguage(v: any): boolean
	return v == "ru" or v == "uk" or v == "en" or v == "da"
end

local function sanitizeStory(raw: any): QuestEngine.StoryState
	local base = QuestEngine.defaultStoryState()
	if type(raw) ~= "table" then
		return base
	end
	base.activeQuestId = type(raw.activeQuestId) == "string" and raw.activeQuestId or base.activeQuestId
	base.activeStepId = type(raw.activeStepId) == "string" and raw.activeStepId or base.activeStepId
	base.completedQuests = type(raw.completedQuests) == "table" and raw.completedQuests or base.completedQuests
	base.chapter = type(raw.chapter) == "number" and raw.chapter or base.chapter
	base.chapterComplete = type(raw.chapterComplete) == "table" and raw.chapterComplete or base.chapterComplete
	base.decisions = type(raw.decisions) == "table" and raw.decisions or base.decisions
	base.relationships = type(raw.relationships) == "table" and raw.relationships or base.relationships
	base.uniqueItems = type(raw.uniqueItems) == "table" and raw.uniqueItems or base.uniqueItems
	base.grantedRewards = type(raw.grantedRewards) == "table" and raw.grantedRewards or base.grantedRewards
	base.storyEnding = type(raw.storyEnding) == "string" and raw.storyEnding or nil
	base.freePlay = raw.freePlay == true
	base.hangoutStage = type(raw.hangoutStage) == "number" and raw.hangoutStage or 0
	base.ch0HouseZones = type(raw.ch0HouseZones) == "table" and raw.ch0HouseZones or base.ch0HouseZones
	return base
end

function ProfileSchema.sanitize(raw: any): (Profile?, string?)
	if type(raw) ~= "table" then
		return nil, "not_a_table"
	end
	local coins = raw.coins
	if type(coins) ~= "number" or coins < 0 or coins ~= coins then
		return nil, "invalid_coins"
	end
	local lang = raw.language
	if not isLanguage(lang) then
		lang = "ru"
	end
	local settings = raw.settings
	if type(settings) ~= "table" then
		settings = table.clone(DEFAULT_SETTINGS)
	end

	local story = sanitizeStory(raw.story)
	-- legacy v3 fields
	if raw.story == nil and raw.tutorialStep ~= nil then
		story = QuestEngine.defaultStoryState()
		if raw.tutorialStep == "chapter_complete" or raw.chapterComplete == true then
			story.completedQuests[QuestEngine.defaultStoryState().activeQuestId] = true
			story.chapter = 1
			story.activeQuestId = "q_ch1_initiation_choice"
			story.activeStepId = "ch1_s_choice"
		end
		if type(raw.grantedRewards) == "table" then
			story.grantedRewards = raw.grantedRewards
		end
		if type(raw.questFlags) == "table" then
			for k, v in raw.questFlags do
				if v then
					story.completedQuests[k] = true
				end
			end
		end
	end

	local profile: Profile = {
		schemaVersion = type(raw.schemaVersion) == "number" and raw.schemaVersion or 0,
		coins = math.floor(coins),
		xp = type(raw.xp) == "number" and math.max(0, math.floor(raw.xp)) or 0,
		level = type(raw.level) == "number" and math.max(1, math.floor(raw.level)) or 1,
		language = lang,
		avatarPreset = type(raw.avatarPreset) == "string" and raw.avatarPreset or "",
		story = story,
		inventory = type(raw.inventory) == "table" and raw.inventory or {},
		roomDecor = type(raw.roomDecor) == "table" and raw.roomDecor or {},
		settings = {
			musicVolume = type(settings.musicVolume) == "number" and settings.musicVolume or 0.7,
			voiceVolume = type(settings.voiceVolume) == "number" and settings.voiceVolume or 1,
			sfxVolume = type(settings.sfxVolume) == "number" and settings.sfxVolume or 0.8,
			angelinaHints = settings.angelinaHints ~= false,
			subtitles = settings.subtitles ~= false,
		},
	}
	return profile, nil
end

function ProfileSchema.isEmptyProfile(raw: any): boolean
	if raw == nil then
		return true
	end
	if type(raw) ~= "table" then
		return true
	end
	if next(raw) == nil then
		return true
	end
	return false
end

return ProfileSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">QuestEngine</string>
          <string name="Source"><![CDATA[--!strict
local QuestTable = if script and script.Parent
	then require(script.Parent.Parent.Config.QuestTable)
	else require("../Config/QuestTable")

local QuestEngine = {}

export type StoryState = {
	activeQuestId: string,
	activeStepId: string,
	completedQuests: { [string]: boolean },
	chapter: number,
	chapterComplete: { [number]: boolean },
	decisions: { [string]: string },
	relationships: { [string]: number },
	uniqueItems: { [string]: boolean },
	grantedRewards: { [string]: boolean },
	storyEnding: string?,
	freePlay: boolean,
	hangoutStage: number,
	ch0HouseZones: { [string]: boolean },
}

function QuestEngine.defaultStoryState(): StoryState
	return {
		activeQuestId = QuestTable.CH0,
		activeStepId = "ch0_s_awake",
		completedQuests = {},
		chapter = 0,
		chapterComplete = {},
		decisions = {},
		relationships = {
			razor = 0,
			vienna = 0,
			gang_rust = 0,
			count = 0,
		},
		uniqueItems = {},
		grantedRewards = {},
		storyEnding = nil,
		freePlay = false,
		hangoutStage = 0,
		ch0HouseZones = {},
	}
end

function QuestEngine.currentStep(state: StoryState): QuestTable.QuestStep?
	return QuestTable.stepDef(state.activeQuestId, state.activeStepId)
end

function QuestEngine.stepExpectsEvent(state: StoryState, eventId: string): boolean
	local step = QuestEngine.currentStep(state)
	return step ~= nil and step.completeEvent == eventId
end

local REWARD_TABLE = {
	reward_ch0_complete = { coins = 30, xp = 25, rel = { "razor", 5 } },
	reward_initiation_pay = { xp = 50, rel = { "gang_rust", 10 } },
	reward_initiation_duel = { xp = 60, rel = { "gang_rust", 15 } },
	reward_initiation_graffiti = { xp = 45, rel = { "gang_rust", 10 } },
	reward_ch2_hangout = { xp = 80, rel = { "vienna", 10 } },
	reward_ch2_choice = { xp = 20 },
	reward_ch3_rim = { unique = "bell_rim", xp = 70 },
	reward_ending_curse = { coins = 200, xp = 150 },
	reward_ending_zombie = { coins = 200, xp = 150 },
	reward_ending_deal = { coins = 250, xp = 150 },
}

export type GrantResult = {
	granted: boolean,
	coinsDelta: number,
	xpDelta: number,
}

function QuestEngine.grantReward(state: StoryState, grantKey: string): GrantResult
	local result: GrantResult = { granted = false, coinsDelta = 0, xpDelta = 0 }
	if state.grantedRewards[grantKey] then
		return result
	end
	local spec = REWARD_TABLE[grantKey]
	if not spec then
		return result
	end
	state.grantedRewards[grantKey] = true
	result.granted = true
	if spec.coins then
		result.coinsDelta = spec.coins
	end
	if spec.xp then
		result.xpDelta = spec.xp
	end
	if spec.rel then
		local key, val = spec.rel[1], spec.rel[2]
		state.relationships[key] = (state.relationships[key] or 0) + val
	end
	if spec.unique then
		state.uniqueItems[spec.unique] = true
	end
	return result
end

function QuestEngine.advanceStep(state: StoryState): (boolean, GrantResult?)
	local quest = QuestTable.get(state.activeQuestId)
	if not quest then
		return false, nil
	end
	local idx = 0
	for i, s in quest.steps do
		if s.id == state.activeStepId then
			idx = i
			break
		end
	end
	if idx == 0 then
		return false, nil
	end
	if idx < #quest.steps then
		state.activeStepId = quest.steps[idx + 1].id
		return true, nil
	end
	-- quest complete
	state.completedQuests[state.activeQuestId] = true
	local grant: GrantResult? = nil
	if quest.rewardGrantKey then
		grant = QuestEngine.grantReward(state, quest.rewardGrantKey)
	end
	if state.activeQuestId == QuestTable.CH0 then
		state.chapterComplete[0] = true
		state.chapter = 1
		state.activeQuestId = QuestTable.CH1_CHOICE
		local first = QuestTable.firstStep(QuestTable.CH1_CHOICE)
		state.activeStepId = if first then first.id else ""
	elseif quest.nextQuestId then
		state.activeQuestId = quest.nextQuestId
		local first = QuestTable.firstStep(quest.nextQuestId)
		state.activeStepId = if first then first.id else ""
		local nq = QuestTable.get(quest.nextQuestId)
		if nq then
			state.chapter = math.max(state.chapter, nq.chapter)
		end
	end
	return true, grant
end

function QuestEngine.tryCompleteEvent(state: StoryState, eventId: string): (boolean, GrantResult?)
	if not QuestEngine.stepExpectsEvent(state, eventId) then
		return false, nil
	end
	return QuestEngine.advanceStep(state)
end

function QuestEngine.setDecision(state: StoryState, key: string, value: string): boolean
	if state.decisions[key] ~= nil then
		return false
	end
	state.decisions[key] = value
	return true
end

function QuestEngine.pickInitiationPath(state: StoryState, path: "pay" | "duel" | "graffiti"): boolean
	if state.activeQuestId ~= QuestTable.CH1_CHOICE or state.activeStepId ~= "ch1_s_choice" then
		return false
	end
	if not QuestEngine.setDecision(state, "initiation", path) then
		return false
	end
	state.completedQuests[QuestTable.CH1_CHOICE] = true
	local nextId = if path == "pay"
		then "q_initiation_pay"
		elseif path == "duel" then "q_initiation_duel"
		else "q_initiation_graffiti"
	state.completedQuests[QuestTable.CH1_CHOICE] = true
	state.activeQuestId = nextId
	local first = QuestTable.firstStep(nextId)
	state.activeStepId = if first then first.id else ""
	return true
end

function QuestEngine.grantUniqueItem(state: StoryState, itemId: string): boolean
	if state.uniqueItems[itemId] then
		return false
	end
	state.uniqueItems[itemId] = true
	return true
end

function QuestEngine.pickEnding(state: StoryState, endingId: string): boolean
	if state.activeQuestId ~= "q_ch4_castle" or state.activeStepId ~= "ch4_s_ending" then
		return false
	end
	local ending = QuestTable.endings[endingId]
	if not ending then
		return false
	end
	QuestEngine.grantReward(state, ending.grantKey)
	state.storyEnding = endingId
	state.freePlay = true
	state.completedQuests["q_ch4_castle"] = true
	state.chapterComplete[4] = true
	state.chapter = 4
	return true
end

-- Special handlers for compound events
function QuestEngine.trySpecial(state: StoryState, eventId: string, ctx: { coins: number }?): (boolean, GrantResult?)
	if eventId == "coins>=150" and state.activeQuestId == "q_initiation_pay" then
		if ctx and ctx.coins >= 150 then
			return QuestEngine.tryCompleteEvent(state, eventId)
		end
		return false, nil
	end
	if eventId == "hangout_stage>=4" and state.activeQuestId == QuestTable.CH2 then
		if state.hangoutStage >= 4 then
			return QuestEngine.tryCompleteEvent(state, eventId)
		end
		return false, nil
	end
	return QuestEngine.tryCompleteEvent(state, eventId)
end

return QuestEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ReceiptStore</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Idempotent ProcessReceipt / dev product fulfillment (pure store interface).
]]

local ReceiptStore = {}

export type MemoryStore = { [string]: boolean }

function ReceiptStore.wasProcessed(store: MemoryStore, purchaseId: string): boolean
	return store[purchaseId] == true
end

export type FulfillResult = "granted" | "duplicate" | "unknown_product"

function ReceiptStore.fulfill(
	store: MemoryStore,
	purchaseId: string,
	productId: number,
	testProductIds: { [number]: string }
): FulfillResult
	if ReceiptStore.wasProcessed(store, purchaseId) then
		return "duplicate"
	end
	if testProductIds[productId] == nil then
		return "unknown_product"
	end
	store[purchaseId] = true
	return "granted"
end

return ReceiptStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">RemoteValidation</string>
          <string name="Source"><![CDATA[--!strict
local RemoteValidation = {}

export type Bucket = {
	lastAt: number,
	count: number,
}

function RemoteValidation.newBucket(): Bucket
	return { lastAt = 0, count = 0 }
end

function RemoteValidation.checkRate(bucket: Bucket, now: number, windowSec: number, maxInWindow: number): boolean
	if now - bucket.lastAt > windowSec then
		bucket.lastAt = now
		bucket.count = 0
	end
	if bucket.count >= maxInWindow then
		return false
	end
	bucket.count += 1
	return true
end

function RemoteValidation.validateString(value: any, maxLen: number): string?
	if type(value) ~= "string" then
		return nil
	end
	if #value > maxLen or #value == 0 then
		return nil
	end
	return value
end

function RemoteValidation.validateEnum<T>(value: any, allowed: { T }): T?
	for _, v in allowed do
		if value == v then
			return value
		end
	end
	return nil
end

return RemoteValidation
]]></string>
        </Properties>
      </Item>
    </Item>
