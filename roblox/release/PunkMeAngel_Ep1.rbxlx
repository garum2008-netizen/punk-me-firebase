      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="51">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="52">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="53">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="54">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AngelinaLines = require(ReplicatedStorage.Shared.AngelinaLines)
local AvatarPresets = require(ReplicatedStorage.Config.AvatarPresets)
local QuestTable = require(ReplicatedStorage.Config.QuestTable)
local EndingLogic = require(ReplicatedStorage.Shared.EndingLogic)
local FlyerEngine = require(ReplicatedStorage.Shared.FlyerEngine)
local ShopCatalog = require(ReplicatedStorage.Config.ShopCatalog)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local profile: any = nil
local lookedRoom = false
local interactDone = false

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local profileUpdated = remotes:WaitForChild("ProfileUpdated") :: RemoteEvent
local requestAction = remotes:WaitForChild("RequestAction") :: RemoteEvent

local screen = Instance.new("ScreenGui")
screen.Name = "PunkMeHUD"
screen.ResetOnSpawn = false
screen.Parent = playerGui

local questLabel = Instance.new("TextLabel")
questLabel.Size = UDim2.new(0, 360, 0, 72)
questLabel.Position = UDim2.new(0, 10, 0, 10)
questLabel.BackgroundTransparency = 0.25
questLabel.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
questLabel.TextColor3 = Color3.new(1, 1, 1)
questLabel.TextWrapped = true
questLabel.Font = Enum.Font.GothamBold
questLabel.TextSize = 15
questLabel.Parent = screen

local coinsLabel = Instance.new("TextLabel")
coinsLabel.Size = UDim2.new(0, 180, 0, 28)
coinsLabel.Position = UDim2.new(0, 10, 0, 88)
coinsLabel.BackgroundTransparency = 0.2
coinsLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
coinsLabel.Font = Enum.Font.GothamBold
coinsLabel.TextSize = 16
coinsLabel.Parent = screen

local flyerLabel = Instance.new("TextLabel")
flyerLabel.Size = UDim2.new(0, 200, 0, 24)
flyerLabel.Position = UDim2.new(0, 10, 0, 118)
flyerLabel.BackgroundTransparency = 0.3
flyerLabel.TextColor3 = Color3.fromRGB(255, 180, 220)
flyerLabel.Font = Enum.Font.Gotham
flyerLabel.TextSize = 14
flyerLabel.Visible = false
flyerLabel.Parent = screen

local duelHint = Instance.new("TextLabel")
duelHint.Size = UDim2.new(0, 280, 0, 40)
duelHint.Position = UDim2.new(0.5, -140, 0.2, 0)
duelHint.BackgroundTransparency = 0.2
duelHint.TextColor3 = Color3.fromRGB(255, 120, 120)
duelHint.Text =
	"Дуэль: иди на арену (красная площадка) и поговори с Рейзором"
duelHint.Visible = false
duelHint.Parent = screen

local angelinaFrame = Instance.new("Frame")
angelinaFrame.Size = UDim2.new(0, 300, 0, 110)
angelinaFrame.Position = UDim2.new(1, -310, 1, -120)
angelinaFrame.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
angelinaFrame.Parent = screen

local angelinaText = Instance.new("TextLabel")
angelinaText.Size = UDim2.new(1, -10, 1, -36)
angelinaText.Position = UDim2.new(0, 5, 0, 4)
angelinaText.BackgroundTransparency = 1
angelinaText.TextColor3 = Color3.fromRGB(240, 220, 255)
angelinaText.TextWrapped = true
angelinaText.TextXAlignment = Enum.TextXAlignment.Left
angelinaText.Font = Enum.Font.Gotham
angelinaText.TextSize = 14
angelinaText.Parent = angelinaFrame

local helpBtn = Instance.new("TextButton")
helpBtn.Size = UDim2.new(0, 90, 0, 28)
helpBtn.Position = UDim2.new(0, 5, 1, -32)
helpBtn.Text = "Помоги"
helpBtn.Parent = angelinaFrame

local picker = Instance.new("Frame")
picker.Size = UDim2.new(0, 280, 0, 220)
picker.Position = UDim2.new(0.5, -140, 0.5, -110)
picker.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
picker.Visible = false
picker.Parent = screen

for i, preset in AvatarPresets.list do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 36)
	btn.Position = UDim2.new(0, 10, 0, 10 + (i - 1) * 42)
	btn.Text = preset.id
	btn.Parent = picker
	btn.MouseButton1Click:Connect(function()
		requestAction:FireServer("set_avatar", preset.id)
		picker.Visible = false
	end)
end

local choiceFrame = Instance.new("Frame")
choiceFrame.Size = UDim2.new(0, 300, 0, 120)
choiceFrame.Position = UDim2.new(0.5, -150, 0.7, 0)
choiceFrame.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
choiceFrame.Visible = false
choiceFrame.Parent = screen

local function lang(): AngelinaLines.Lang
	if profile and profile.language then
		return profile.language
	end
	return "ru"
end

local function say(ctx: AngelinaLines.Context)
	angelinaText.Text = AngelinaLines.forContext(ctx, lang())
end

helpBtn.MouseButton1Click:Connect(function()
	say("stuck")
end)

local langRow = Instance.new("Frame")
langRow.Size = UDim2.new(0, 200, 0, 28)
langRow.Position = UDim2.new(0, 10, 0, 146)
langRow.BackgroundTransparency = 1
langRow.Parent = screen
for i, code in { "ru", "uk", "en", "da" } do
	local lb = Instance.new("TextButton")
	lb.Size = UDim2.new(0, 46, 1, 0)
	lb.Position = UDim2.new(0, (i - 1) * 48, 0, 0)
	lb.Text = string.upper(code)
	lb.Parent = langRow
	lb.MouseButton1Click:Connect(function()
		requestAction:FireServer("set_language", code)
	end)
end

local shopFrame = Instance.new("Frame")
shopFrame.Size = UDim2.new(0, 260, 0, 120)
shopFrame.Position = UDim2.new(1, -270, 0.35, 0)
shopFrame.BackgroundColor3 = Color3.fromRGB(25, 15, 35)
shopFrame.Visible = false
shopFrame.Parent = screen
for i, item in ShopCatalog.list do
	local sb = Instance.new("TextButton")
	sb.Size = UDim2.new(1, -12, 0, 32)
	sb.Position = UDim2.new(0, 6, 0, 6 + (i - 1) * 36)
	sb.Text = string.format("%s — %d🪙", item.id, item.price)
	sb.Parent = shopFrame
	sb.MouseButton1Click:Connect(function()
		requestAction:FireServer("shop_buy", item.id)
	end)
end

task.delay(1.5, function()
	if not lookedRoom then
		lookedRoom = true
		requestAction:FireServer("quest_event", "ch0_look_room")
	end
end)

local endingFrame = Instance.new("Frame")
endingFrame.Size = UDim2.new(0, 320, 0, 140)
endingFrame.Position = UDim2.new(0.5, -160, 0.55, 0)
endingFrame.BackgroundColor3 = Color3.fromRGB(25, 10, 35)
endingFrame.Visible = false
endingFrame.Parent = screen

local endingButtons: { [string]: TextButton } = {}
for id, def in QuestTable.endings do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -12, 0, 36)
	b.Text = def.title.ru
	b.Parent = endingFrame
	b.Visible = false
	endingButtons[id] = b
	b.MouseButton1Click:Connect(function()
		requestAction:FireServer("pick_ending", id)
		endingFrame.Visible = false
	end)
end

local function refreshEndings()
	if not profile or not profile.story then
		return
	end
	local st = profile.story
	local rec = EndingLogic.recommended(st)
	for id, b in endingButtons do
		local can = EndingLogic.canPick(st, id :: EndingLogic.EndingId)
		b.Visible = can
		local star = if id == rec then " ★" else ""
		b.Text = QuestTable.endings[id].title.ru .. star
	end
end

local bullyFrame: Frame
local concertFrame: Frame

local function refreshQuest()
	if not profile or not profile.story then
		return
	end
	local st = profile.story
	local step = QuestTable.stepDef(st.activeQuestId, st.activeStepId)
	if step then
		questLabel.Text = step.objective[lang()] or step.objective.en or st.activeStepId
		if step.angelina then
			say(step.angelina :: AngelinaLines.Context)
		end
	else
		questLabel.Text = st.activeQuestId .. " / " .. st.activeStepId
	end
	coinsLabel.Text = "🪙 " .. tostring(profile.coins)
	if st.activeQuestId == "q_initiation_graffiti" then
		flyerLabel.Visible = true
		local n = FlyerEngine.count(st.flyersPosted)
		flyerLabel.Text = string.format("Флаеры: %d / %d", n, #FlyerEngine.SPOT_IDS)
	else
		flyerLabel.Visible = false
	end
	duelHint.Visible = st.activeQuestId == "q_initiation_duel"
	shopFrame.Visible = st.activeStepId == "s1" and st.activeQuestId == "q_initiation_pay"
	if st.activeStepId == "ch0_s_avatar" then
		picker.Visible = true
	end
	if st.activeStepId == "ch1_s_choice" then
		choiceFrame.Visible = true
	end
	if bullyFrame then
		bullyFrame.Visible = st.activeQuestId == "q_ch2_antibully"
	end
	if concertFrame then
		concertFrame.Visible = st.activeStepId == "ch4_s_concert"
	end
end

profileUpdated.OnClientEvent:Connect(function(p)
	profile = p
	refreshQuest()
	refreshEndings()
end)

local function bindPrompt(prompt: ProximityPrompt)
	if prompt:GetAttribute("Bound") then
		return
	end
	prompt:SetAttribute("Bound", true)
	prompt.Triggered:Connect(function()
		if not profile or not profile.story then
			return
		end
		local st = profile.story
		local parent = prompt.Parent
		local npcId = parent and parent:GetAttribute("NpcId")
		if not interactDone then
			interactDone = true
			requestAction:FireServer("quest_event", "ch0_interact_done")
		end
		if npcId == "npc_mom" then
			requestAction:FireServer("quest_event", "ch0_mom_talk")
		elseif npcId == "npc_shnurok" then
			requestAction:FireServer("quest_event", "ch0_pet_shnurok")
		elseif npcId == "npc_razor" then
			if st.activeStepId == "ch0_s_razor" then
				requestAction:FireServer("quest_event", "ch0_razor_talk")
			elseif st.activeQuestId == "q_initiation_pay" and st.activeStepId == "s2" then
				requestAction:FireServer("pay_initiation")
			elseif st.activeQuestId == "q_initiation_duel" then
				requestAction:FireServer("duel_start")
			end
		elseif npcId == "npc_gravedigger" then
			requestAction:FireServer("cemetery_job")
		elseif npcId == "npc_zoya" then
			requestAction:FireServer("bell_tongue", "zoya")
		elseif npcId == "npc_count" then
			if st.activeStepId == "ch4_s_confession" then
				requestAction:FireServer("graph_confession")
			elseif st.activeStepId == "ch4_s_ending" then
				refreshEndings()
				endingFrame.Visible = true
			end
		end
		local flyerId = parent and parent:GetAttribute("FlyerSpotId")
		if flyerId then
			requestAction:FireServer("flyer_post", flyerId)
		end
	end)
end

workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("ProximityPrompt") then
		bindPrompt(inst)
	end
end)
for _, inst in workspace:GetDescendants() do
	if inst:IsA("ProximityPrompt") then
		bindPrompt(inst)
	end
end

local function addChoice(text: string, action: string, payload: string?)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -16, 0, 32)
	b.Position = UDim2.new(0, 8, 0, 8 + #choiceFrame:GetChildren() * 36)
	b.Text = text
	b.Parent = choiceFrame
	b.MouseButton1Click:Connect(function()
		requestAction:FireServer(action, payload)
		choiceFrame.Visible = false
	end)
end

addChoice("Взнос 150", "initiation_choice", "pay")
addChoice("Дуэль", "initiation_choice", "duel")
addChoice("Флаеры", "initiation_choice", "graffiti")

bullyFrame = Instance.new("Frame")
bullyFrame.Size = UDim2.new(0, 280, 0, 90)
bullyFrame.Position = UDim2.new(0.5, -140, 0.65, 0)
bullyFrame.BackgroundColor3 = Color3.fromRGB(30, 20, 40)
bullyFrame.Visible = false
bullyFrame.Parent = screen
local standBtn = Instance.new("TextButton")
standBtn.Size = UDim2.new(0.45, 0, 0, 32)
standBtn.Position = UDim2.new(0.05, 0, 0.5, 0)
standBtn.Text = "Заступиться"
standBtn.Parent = bullyFrame
standBtn.MouseButton1Click:Connect(function()
	requestAction:FireServer("ch2_antibully", "stand")
	bullyFrame.Visible = false
end)
local joinBtn = Instance.new("TextButton")
joinBtn.Size = UDim2.new(0.45, 0, 0, 32)
joinBtn.Position = UDim2.new(0.5, 0, 0.5, 0)
joinBtn.Text = "Поддержать насмешки"
joinBtn.Parent = bullyFrame
joinBtn.MouseButton1Click:Connect(function()
	requestAction:FireServer("ch2_antibully", "join")
	bullyFrame.Visible = false
end)

concertFrame = Instance.new("Frame")
concertFrame.Size = UDim2.new(0, 300, 0, 120)
concertFrame.Position = UDim2.new(0.5, -150, 0.55, 0)
concertFrame.BackgroundColor3 = Color3.fromRGB(25, 15, 35)
concertFrame.Visible = false
concertFrame.Parent = screen
for i, head in { "vienna", "razor", "count", "ghost" } do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.45, 0, 0, 28)
	b.Position = UDim2.new((i - 1) % 2 * 0.5, 8, 0, 8 + math.floor((i - 1) / 2) * 34)
	b.Text = head
	b.Parent = concertFrame
	b.MouseButton1Click:Connect(function()
		requestAction:FireServer("concert_prepare", head)
		concertFrame.Visible = false
	end)
end

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp or not profile or not profile.story then
		return
	end
	local st = profile.story
	if st.activeStepId == "ch0_s_move" then
		local marker = workspace:FindFirstChild("World", true)
		local house = marker and workspace.World:FindFirstChild("House13")
		local m = house and house:FindFirstChild("marker_move") :: BasePart?
		if m and (hrp.Position - m.Position).Magnitude < 8 then
			requestAction:FireServer("quest_event", "ch0_move_done")
		end
	end
	if st.activeStepId == "ch0_s_street" and hrp.Position.X > 55 then
		requestAction:FireServer("quest_event", "ch0_enter_street")
	end
	if st.activeQuestId == "q_ch4_castle" and st.activeStepId == "ch4_s_enter" and hrp.Position.X < -50 then
		requestAction:FireServer("ch4_enter")
	end
	if st.activeStepId == "ch4_s_tongue" and hrp.Position.X > -60 and hrp.Position.X < -50 and hrp.Position.Z > 85 then
		requestAction:FireServer("bell_tongue", "zombie")
	end
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("BasePart") and inst:GetAttribute("ZoneId") then
			local zoneId = inst:GetAttribute("ZoneId") :: string
			local rel = hrp.Position - inst.Position
			if
				math.abs(rel.X) < inst.Size.X / 2
				and math.abs(rel.Y) < inst.Size.Y / 2
				and math.abs(rel.Z) < inst.Size.Z / 2
			then
				if zoneId == "zone_room" or zoneId == "zone_hall" then
					requestAction:FireServer("house_zone", zoneId)
				end
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="55">
        <Properties>
          <string name="Name">ClientMechanics</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestAction = remotes:WaitForChild("RequestAction") :: RemoteEvent
local duelUpdate = remotes:WaitForChild("DuelUpdate") :: RemoteEvent
local actionResult = remotes:WaitForChild("ActionResult") :: RemoteEvent
local ClientTouch = require(ReplicatedStorage.Shared.ClientTouch)

local duelGui = Instance.new("ScreenGui")
duelGui.Name = "DuelUI"
duelGui.ResetOnSpawn = false
duelGui.Enabled = false
duelGui.Parent = playerGui

local duelStatus = Instance.new("TextLabel")
duelStatus.Size = UDim2.new(0, 320, 0, 80)
duelStatus.Position = UDim2.new(0.5, -160, 0.35, 0)
duelStatus.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
duelStatus.TextColor3 = Color3.new(1, 1, 1)
duelStatus.TextWrapped = true
duelStatus.Parent = duelGui

local function duelBtn(text: string, action: string, y: number)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 100, 0, 36)
	if ClientTouch.isTouch() then
		b.Size = UDim2.new(0.28, 0, 0, 52)
		b.Position = UDim2.new(0.04 + y * 0.32, 0, 0.72, 0)
	else
		b.Position = UDim2.new(0.5, -160 + y * 110, 0.5, 0)
	end
	b.Text = text
	b.Parent = duelGui
	ClientTouch.stylePrimaryButton(b)
	b.MouseButton1Click:Connect(function()
		requestAction:FireServer("duel_action", action)
	end)
end

duelBtn("Attack", "attack", 0)
duelBtn("Block", "block", 1)
duelBtn("Dodge", "dodge", 2)

duelUpdate.OnClientEvent:Connect(function(state: any, meta: any?)
	if not state then
		return
	end
	duelGui.Enabled = state.phase == "fighting"
	local npcHp = state.opponentHp or 0
	local plHp = state.playerHp or 0
	duelStatus.Text = string.format("You %d  |  Razor %d", plHp, npcHp)
	if meta then
		if meta.hitNpc then
			duelStatus.Text ..= "\nHit!"
		end
		if meta.hitPlayer then
			duelStatus.Text ..= "\nBlocked or hit!"
		end
	end
	if state.phase == "player_win" then
		duelStatus.Text = "Victory!"
		duelGui.Enabled = false
	elseif state.phase == "player_lose" then
		duelStatus.Text = "Try again — go to duel pit"
		duelGui.Enabled = false
	end
end)

local endingOverlay = Instance.new("ScreenGui")
endingOverlay.Name = "EndingScene"
endingOverlay.ResetOnSpawn = false
endingOverlay.Enabled = false
endingOverlay.Parent = playerGui

local endingText = Instance.new("TextLabel")
endingText.Size = UDim2.new(0.8, 0, 0.5, 0)
endingText.Position = UDim2.new(0.1, 0, 0.25, 0)
endingText.BackgroundColor3 = Color3.fromRGB(10, 5, 20)
endingText.TextColor3 = Color3.fromRGB(255, 220, 255)
endingText.TextWrapped = true
endingText.TextSize = 20
endingText.Parent = endingOverlay

actionResult.OnClientEvent:Connect(function(res)
	if res and res.ok and res.endingScene then
		endingOverlay.Enabled = true
		endingText.Text = res.endingScene
		task.delay(12, function()
			endingOverlay.Enabled = false
		end)
	end
end)

local towerGui = Instance.new("ScreenGui")
towerGui.Name = "TowerPuzzleUI"
towerGui.ResetOnSpawn = false
towerGui.Parent = playerGui

local towerFrame = Instance.new("Frame")
towerFrame.Size = UDim2.new(0, 320, 0, 220)
towerFrame.Position = UDim2.new(0.5, -160, 0.4, 0)
towerFrame.BackgroundColor3 = Color3.fromRGB(15, 10, 25)
towerFrame.Visible = false
towerFrame.Parent = towerGui

local candleOrder: { number } = {}
local noteOrder: { string } = {}

local candleLabel = Instance.new("TextLabel")
candleLabel.Size = UDim2.new(1, -10, 0, 24)
candleLabel.Position = UDim2.new(0, 5, 0, 4)
candleLabel.Text = "Свечи (порядок зажигания):"
candleLabel.TextColor3 = Color3.new(1, 1, 1)
candleLabel.Parent = towerFrame

for i = 1, 4 do
	local cb = Instance.new("TextButton")
	cb.Size = UDim2.new(0, 60, 0, 28)
	cb.Position = UDim2.new(0, 8 + (i - 1) * 64, 0, 32)
	cb.Text = tostring(i)
	cb.Parent = towerFrame
	cb.MouseButton1Click:Connect(function()
		table.insert(candleOrder, i)
		candleLabel.Text = "Свечи: " .. table.concat(candleOrder, "-")
	end)
end

local noteLabel = Instance.new("TextLabel")
noteLabel.Size = UDim2.new(1, -10, 0, 24)
noteLabel.Position = UDim2.new(0, 5, 0, 68)
noteLabel.Text = "Орган (ноты):"
noteLabel.TextColor3 = Color3.new(1, 1, 1)
noteLabel.Parent = towerFrame

for j, note in { "C", "D", "E", "G" } do
	local nb = Instance.new("TextButton")
	nb.Size = UDim2.new(0, 60, 0, 28)
	nb.Position = UDim2.new(0, 8 + (j - 1) * 64, 0, 96)
	nb.Text = note
	nb.Parent = towerFrame
	nb.MouseButton1Click:Connect(function()
		table.insert(noteOrder, note)
		noteLabel.Text = "Орган: " .. table.concat(noteOrder, " ")
	end)
end

local resetTower = Instance.new("TextButton")
resetTower.Size = UDim2.new(0, 80, 0, 28)
resetTower.Position = UDim2.new(0, 8, 0, 132)
resetTower.Text = "Сброс"
resetTower.Parent = towerFrame
resetTower.MouseButton1Click:Connect(function()
	candleOrder = {}
	noteOrder = {}
	candleLabel.Text = "Свечи (порядок зажигания):"
	noteLabel.Text = "Орган (ноты):"
end)

local submitTower = Instance.new("TextButton")
submitTower.Size = UDim2.new(0, 120, 0, 32)
submitTower.Position = UDim2.new(0, 100, 0, 132)
submitTower.Text = "Проверить"
submitTower.Parent = towerFrame
ClientTouch.stylePrimaryButton(submitTower)
ClientTouch.stylePrimaryButton(resetTower)
for _, child in towerFrame:GetChildren() do
	if child:IsA("TextButton") then
		ClientTouch.stylePrimaryButton(child)
	end
end
submitTower.MouseButton1Click:Connect(function()
	requestAction:FireServer("tower_puzzle", { candles = candleOrder, notes = noteOrder })
end)

local towerOpen = Instance.new("TextButton")
towerOpen.Size = UDim2.new(0, 200, 0, 40)
towerOpen.Position = UDim2.new(1, -210, 0.5, 0)
towerOpen.Text = "Башня: головоломка"
towerOpen.Visible = false
towerOpen.Parent = towerGui
ClientTouch.stylePrimaryButton(towerOpen)
towerOpen.MouseButton1Click:Connect(function()
	towerFrame.Visible = not towerFrame.Visible
end)

local profileUpdated = remotes:WaitForChild("ProfileUpdated") :: RemoteEvent
profileUpdated.OnClientEvent:Connect(function(p)
	if p and p.story and p.story.activeStepId == "ch4_s_crown" then
		towerOpen.Visible = true
	else
		towerOpen.Visible = false
		towerFrame.Visible = false
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="56">
        <Properties>
          <string name="Name">ClientMinigames</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local CryptBuildEngine = require(ReplicatedStorage.Shared.CryptBuildEngine)
local GhostRiddleEngine = require(ReplicatedStorage.Shared.GhostRiddleEngine)
local ClientTouch = require(ReplicatedStorage.Shared.ClientTouch)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestAction = remotes:WaitForChild("RequestAction") :: RemoteEvent

local profile: any = nil
remotes:WaitForChild("ProfileUpdated").OnClientEvent:Connect(function(p)
	profile = p
end)

local hangoutGui = Instance.new("ScreenGui")
hangoutGui.Name = "HangoutMinigame"
hangoutGui.ResetOnSpawn = false
hangoutGui.Enabled = false
hangoutGui.Parent = playerGui

local hangTitle = Instance.new("TextLabel")
hangTitle.Size = UDim2.new(1, -20, 0, 40)
hangTitle.Position = UDim2.new(0, 10, 0, 8)
hangTitle.BackgroundTransparency = 1
hangTitle.TextColor3 = Color3.new(1, 1, 1)
hangTitle.TextWrapped = true
hangTitle.Parent = hangoutGui

local hangInput = Instance.new("TextBox")
hangInput.Size = UDim2.new(1, -20, 0, 36)
hangInput.Position = UDim2.new(0, 10, 0, 52)
hangInput.Parent = hangoutGui

local hangSubmit = Instance.new("TextButton")
hangSubmit.Size = UDim2.new(0, 120, 0, 32)
hangSubmit.Position = UDim2.new(0.5, -60, 0, 96)
hangSubmit.Text = "Готово"
hangSubmit.Parent = hangoutGui
ClientTouch.stylePrimaryButton(hangSubmit)

local pendingHangoutStage: string? = nil

local HANGOUT_COPY: { [string]: string } = {
	foundation = "Фундамент: введи порядок блоков (подсказка: 2-4-1)",
	frame = "Каркас: кодовое слово каркаса",
	neon = "Неон: сколько ламп? (цифра+neon)",
	grand_open = "Открытие: название места латиницей",
}

local function openHangout(stage: string)
	pendingHangoutStage = stage
	hangTitle.Text = HANGOUT_COPY[stage] or stage
	hangInput.Text = ""
	hangoutGui.Enabled = true
end

hangSubmit.MouseButton1Click:Connect(function()
	if pendingHangoutStage then
		requestAction:FireServer("hangout_build", { stage = pendingHangoutStage, answer = hangInput.Text })
		hangoutGui.Enabled = false
		pendingHangoutStage = nil
	end
end)

local ghostGui = Instance.new("ScreenGui")
ghostGui.Name = "GhostRiddle"
ghostGui.ResetOnSpawn = false
ghostGui.Enabled = false
ghostGui.Parent = playerGui

local ghostQ = Instance.new("TextLabel")
ghostQ.Size = UDim2.new(0.9, 0, 0, 60)
ghostQ.Position = UDim2.new(0.05, 0, 0, 10)
ghostQ.TextWrapped = true
ghostQ.TextColor3 = Color3.fromRGB(200, 220, 255)
ghostQ.Parent = ghostGui

local ghostInput = Instance.new("TextBox")
ghostInput.Size = UDim2.new(0.9, 0, 0, 32)
ghostInput.Position = UDim2.new(0.05, 0, 0, 78)
ghostInput.Parent = ghostGui

local ghostSubmit = Instance.new("TextButton")
ghostSubmit.Size = UDim2.new(0, 100, 0, 30)
ghostSubmit.Position = UDim2.new(0.35, 0, 0, 118)
ghostSubmit.Text = "Ответ"
ghostSubmit.Parent = ghostGui
ClientTouch.stylePrimaryButton(ghostSubmit)

local RIDDLE_TEXT = {
	"Что звенит над Веной и зовёт мёртвинов?",
	"Где призраки ждут ночью?",
	"Кто держит город в ритме?",
}

local function openGhost()
	local step = (profile and profile.story and profile.story.ghostRiddleStep) or 0
	if step >= GhostRiddleEngine.RIDDLE_COUNT then
		return
	end
	ghostQ.Text = RIDDLE_TEXT[step + 1] or "..."
	ghostInput.Text = ""
	ghostGui.Enabled = true
end

ghostSubmit.MouseButton1Click:Connect(function()
	requestAction:FireServer("ch3_ghost", ghostInput.Text)
	ghostGui.Enabled = false
end)

local cryptGui = Instance.new("ScreenGui")
cryptGui.Name = "CryptBuild"
cryptGui.ResetOnSpawn = false
cryptGui.Enabled = false
cryptGui.Parent = playerGui

local cryptLabel = Instance.new("TextLabel")
cryptLabel.Size = UDim2.new(0.9, 0, 0, 50)
cryptLabel.Position = UDim2.new(0.05, 0, 0, 8)
cryptLabel.TextWrapped = true
cryptLabel.TextColor3 = Color3.new(1, 1, 1)
cryptLabel.Parent = cryptGui

local cryptInput = Instance.new("TextBox")
cryptInput.Size = UDim2.new(0.9, 0, 0, 32)
cryptInput.Position = UDim2.new(0.05, 0, 0, 64)
cryptInput.Parent = cryptGui

local cryptSubmit = Instance.new("TextButton")
cryptSubmit.Size = UDim2.new(0, 100, 0, 30)
cryptSubmit.Position = UDim2.new(0.35, 0, 0, 102)
cryptSubmit.Text = "Строить"
cryptSubmit.Parent = cryptGui
ClientTouch.stylePrimaryButton(cryptSubmit)

local CRYPT_HINTS = {
	"Фаза 1: крепления (4stakes)",
	"Фаза 2: фамилия на плите",
	"Фаза 3: печать с колоколом",
}

local function openCrypt()
	local phase = (profile and profile.story and profile.story.cryptPhase) or 0
	if phase >= CryptBuildEngine.PHASE_COUNT then
		return
	end
	local phaseId = CryptBuildEngine.PHASE_IDS[phase + 1]
	cryptLabel.Text = CRYPT_HINTS[phase + 1] or phaseId
	cryptInput.Text = ""
	cryptGui.Enabled = true
	cryptGui:SetAttribute("PendingPhase", phaseId)
end

cryptSubmit.MouseButton1Click:Connect(function()
	local phase = cryptGui:GetAttribute("PendingPhase")
	if type(phase) == "string" then
		requestAction:FireServer("ch3_crypt", { phase = phase, answer = cryptInput.Text })
		cryptGui.Enabled = false
	end
end)

local function bindPrompt(prompt: ProximityPrompt)
	if prompt:GetAttribute("MinigameBound") then
		return
	end
	prompt:SetAttribute("MinigameBound", true)
	prompt.Triggered:Connect(function()
		local parent = prompt.Parent
		local hangoutStage = parent and parent:GetAttribute("HangoutStage")
		if hangoutStage then
			openHangout(hangoutStage :: string)
			return
		end
		if parent and parent.Name == "obj_crypt_site" then
			openCrypt()
			return
		end
		local npcId = parent and parent:GetAttribute("NpcId")
		if npcId == "npc_ghost" then
			openGhost()
		end
	end)
end

for _, inst in workspace:GetDescendants() do
	if inst:IsA("ProximityPrompt") then
		bindPrompt(inst)
	end
end
workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("ProximityPrompt") then
		bindPrompt(inst)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="57">
        <Properties>
          <string name="Name">SceneDirector</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local SceneCatalog = require(ReplicatedStorage.Config.SceneCatalog)
local MusicCatalog = require(ReplicatedStorage.Config.MusicCatalog)
local NpcAnim = require(ReplicatedStorage.Shared.NpcAnim)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionResult = remotes:WaitForChild("ActionResult") :: RemoteEvent

local gui = Instance.new("ScreenGui")
gui.Name = "SceneDirector"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
gui.Parent = player:WaitForChild("PlayerGui")

local dialogue = Instance.new("TextLabel")
dialogue.Size = UDim2.new(0.85, 0, 0, 100)
dialogue.Position = UDim2.new(0.075, 0, 0.78, 0)
dialogue.BackgroundColor3 = Color3.fromRGB(8, 6, 14)
dialogue.BackgroundTransparency = 0.15
dialogue.TextColor3 = Color3.fromRGB(255, 240, 255)
dialogue.TextWrapped = true
dialogue.TextSize = 18
dialogue.Visible = false
dialogue.Parent = gui

local playing = false

local function vec3(t: { x: number, y: number, z: number }): Vector3
	return Vector3.new(t.x, t.y, t.z)
end

local function findNpc(npcId: string): Model?
	local world = workspace:FindFirstChild("World")
	if not world then
		return nil
	end
	for _, desc in world:GetDescendants() do
		if desc:IsA("Model") and desc:GetAttribute("NpcId") == npcId then
			return desc
		end
	end
	return nil
end

local function playMusic(slot: string?)
	if not slot then
		return
	end
	local id = (MusicCatalog :: any)[slot]
	if type(id) ~= "string" or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = 0.6
	s.Parent = SoundService
	s:Play()
	game:GetService("Debris"):AddItem(s, 30)
end

local function playScene(sceneId: string, lang: string)
	if playing then
		return
	end
	local def = SceneCatalog.get(sceneId)
	if not def or not camera then
		return
	end
	playing = true
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local oldWalk = hum and hum.WalkSpeed or 16
	if hum then
		hum.WalkSpeed = 0
	end

	playMusic(def.musicSlot)
	for _, npcId in def.npcIds do
		local m = findNpc(npcId)
		if m then
			NpcAnim.playTalk(m)
		end
	end

	local from = CFrame.new(vec3(def.cameraFrom), vec3(def.lookAt))
	local to = CFrame.new(vec3(def.cameraTo), vec3(def.lookAt))
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = from
	local tween =
		TweenService:Create(camera, TweenInfo.new(def.durationSec * 0.35, Enum.EasingStyle.Sine), { CFrame = to })
	tween:Play()

	dialogue.Visible = true
	for _, line in def.dialogue do
		local text = if lang == "ru" then line.ru else line.en
		dialogue.Text = line.speaker .. ": " .. text
		task.wait(math.max(2.5, def.durationSec / #def.dialogue))
	end
	dialogue.Visible = false

	task.wait(0.5)
	camera.CameraType = Enum.CameraType.Custom
	if hum then
		hum.WalkSpeed = oldWalk
	end
	for _, npcId in def.npcIds do
		local m = findNpc(npcId)
		if m then
			NpcAnim.playIdle(m)
		end
	end
	playing = false
end

actionResult.OnClientEvent:Connect(function(res)
	if res and res.ok and res.playSceneId then
		local lang = if type(res.language) == "string" then res.language else "ru"
		task.spawn(playScene, res.playSceneId :: string, lang)
	end
end)

remotes:WaitForChild("ProfileUpdated").OnClientEvent:Connect(function(profile)
	if profile and profile.language then
		player:SetAttribute("Language", profile.language)
	end
end)
]]></string>
        </Properties>
      </Item>
