    <Item class="ModuleScript" referent="43">
      <Properties>
        <string name="Name">NpcInteractService</string>
        <string name="Source"><![CDATA[--!strict
local NpcAnimator = require(script.Parent.NpcAnimator)

local NpcInteractService = {}

function NpcInteractService.playTalk(npcId: string)
	local world = workspace:FindFirstChild("World")
	if not world then
		return
	end
	for _, desc in world:GetDescendants() do
		if desc:IsA("Model") and desc:GetAttribute("NpcId") == npcId then
			NpcAnimator.playTalk(desc)
			task.delay(2.5, function()
				NpcAnimator.playIdle(desc)
			end)
			return
		end
	end
end

return NpcInteractService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="44">
      <Properties>
        <string name="Name">ProfileService</string>
        <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ProfileSchema = require(game.ReplicatedStorage.Shared.ProfileSchema)
local ProfileMigrator = require(game.ReplicatedStorage.Shared.ProfileMigrator)
local DataStoreScope = require(game.ReplicatedStorage.Shared.DataStoreScope)

local ProfileService = {}
ProfileService.__index = ProfileService

export type Session = {
	profile: ProfileSchema.Profile,
	locked: boolean,
	userId: number,
}

local STORE_BASE = "PunkMeAngel_Profile_v1"
local MAX_RETRIES = 5
local RETRY_PAUSE = 1

local SessionRegistry = require(game.ReplicatedStorage.Shared.SessionRegistry)

local function getStore(): GlobalDataStore
	local name = DataStoreScope.profileStoreName(STORE_BASE, RunService:IsStudio(), nil)
	return DataStoreService:GetDataStore(name)
end

local function keyForUser(userId: number): string
	return "player_" .. tostring(userId)
end

local function withRetry<T>(fn: () -> T): (T?, string?)
	local lastErr: string? = nil
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return result, nil
		end
		lastErr = tostring(result)
		task.wait(RETRY_PAUSE * attempt)
	end
	return nil, lastErr
end

function ProfileService.load(userId: number): (ProfileSchema.Profile?, string?)
	local store = getStore()
	local k = keyForUser(userId)
	local loaded, loadErr = withRetry(function()
		return store:GetAsync(k)
	end)
	if loadErr and loaded == nil then
		return nil, "load_failed"
	end
	if ProfileSchema.isEmptyProfile(loaded) then
		return ProfileSchema.defaultProfile(), nil
	end
	local migrated, migrateErr = ProfileMigrator.migrate(loaded)
	if not migrated then
		-- Never overwrite existing cloud data with empty defaults on parse failure
		return nil, migrateErr or "migrate_failed"
	end
	return migrated, nil
end

function ProfileService.startSession(userId: number): (Session?, string?)
	local existing = SessionRegistry.getSession(userId)
	if existing and existing.data then
		return existing.data :: Session, nil
	end
	local profile, err = ProfileService.load(userId)
	if not profile then
		return nil, err
	end
	local session: Session = {
		profile = profile,
		locked = true,
		userId = userId,
	}
	SessionRegistry.startSession(userId, session)
	return session, nil
end

function ProfileService.saveSession(session: Session): (boolean, string?)
	local store = getStore()
	local k = keyForUser(session.userId)
	local toSave = session.profile
	local _, saveErr = withRetry(function()
		store:UpdateAsync(k, function(old)
			if ProfileSchema.isEmptyProfile(old) and toSave == nil then
				return nil
			end
			return toSave
		end)
		return true
	end)
	if saveErr then
		return false, saveErr or "save_failed"
	end
	return true, nil
end

function ProfileService.endSession(userId: number)
	SessionRegistry.endSession(userId)
end

function ProfileService.getSession(userId: number): Session?
	local entry = SessionRegistry.getSession(userId)
	if entry and entry.data then
		return entry.data :: Session
	end
	return nil
end

return ProfileService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="45">
      <Properties>
        <string name="Name">RigFactory</string>
        <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")

local AvatarPresets = require(game.ReplicatedStorage.Config.AvatarPresets)
local NpcVisuals = require(game.ReplicatedStorage.Config.NpcVisuals)
local NpcAnimator = require(script.Parent.NpcAnimator)

local RigFactory = {}

local function applyColors(desc: HumanoidDescription, body: Color3, accent: Color3)
	desc.HeadColor = accent
	desc.TorsoColor = body
	desc.LeftArmColor = body
	desc.RightArmColor = body
	desc.LeftLegColor = body
	desc.RightLegColor = body
end

function RigFactory.spawnNpc(parent: Instance, npcId: string, position: Vector3, actionText: string?): Model
	local preset = AvatarPresets.get(npcId:gsub("npc_", ""))
	local visual = (NpcVisuals :: any)[npcId]
	local desc = Instance.new("HumanoidDescription")
	if preset then
		applyColors(desc, preset.bodyColor, preset.accentColor)
	elseif visual then
		applyColors(desc, visual.bodyColor, visual.accentColor)
		if visual.height then
			desc.HeightScale = visual.height
		end
	else
		applyColors(desc, Color3.fromRGB(80, 80, 90), Color3.fromRGB(200, 200, 210))
	end

	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = npcId
	model:SetAttribute("NpcId", npcId)
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		model:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	model.Parent = parent

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText or "Talk"
	prompt.ObjectText = npcId
	prompt.MaxActivationDistance = 12
	prompt.Parent = hrp or model

	NpcAnimator.playIdle(model)
	return model
end

return RigFactory
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="46">
      <Properties>
        <string name="Name">StoryHandlers</string>
        <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local QuestEngine = require(ReplicatedStorage.Shared.QuestEngine)
local ProfileSchema = require(ReplicatedStorage.Shared.ProfileSchema)
local QuestTable = require(ReplicatedStorage.Config.QuestTable)
local FlyerEngine = require(ReplicatedStorage.Shared.FlyerEngine)
local HangoutEngine = require(ReplicatedStorage.Shared.HangoutEngine)
local HangoutMinigame = require(ReplicatedStorage.Shared.HangoutMinigame)
local GhostRiddleEngine = require(ReplicatedStorage.Shared.GhostRiddleEngine)
local CryptBuildEngine = require(ReplicatedStorage.Shared.CryptBuildEngine)
local TowerPuzzle = require(ReplicatedStorage.Shared.TowerPuzzle)
local EndingLogic = require(ReplicatedStorage.Shared.EndingLogic)
local WorldState = require(script.Parent.WorldState)

local StoryHandlers = {}

local function applyGrants(profile: ProfileSchema.Profile, grant: QuestEngine.GrantResult)
	if grant.granted then
		profile.coins += grant.coinsDelta
		if grant.xpDelta > 0 then
			profile.xp, profile.level = Economy.applyXp(profile.xp + grant.xpDelta, profile.level)
		end
	end
end

function StoryHandlers.handleEvent(profile: ProfileSchema.Profile, eventId: string): boolean
	local story = profile.story
	if eventId == "event:pay_initiation_fee" then
		if profile.coins < 150 then
			return false
		end
		profile.coins -= 150
	end
	local ok, grant = QuestEngine.trySpecial(story, eventId, { coins = profile.coins })
	if not ok then
		return false
	end
	if grant then
		applyGrants(profile, grant)
	end
	return true
end

function StoryHandlers.handleInitiationChoice(profile: ProfileSchema.Profile, path: string): boolean
	if path ~= "pay" and path ~= "duel" and path ~= "graffiti" then
		return false
	end
	return QuestEngine.pickInitiationPath(profile.story, path :: "pay" | "duel" | "graffiti")
end

function StoryHandlers.handleCemeteryJob(profile: ProfileSchema.Profile): boolean
	local story = profile.story
	if story.activeQuestId == "q_initiation_pay" and story.activeStepId == "s1" then
		local key = "job_cemetery_ch1"
		local newCoins, granted, _ = Economy.payJobReward(profile.coins, 65, key, story.grantedRewards)
		if granted then
			story.grantedRewards[key] = true
			profile.coins = newCoins
			QuestEngine.trySpecial(story, "coins>=150", { coins = profile.coins })
			return true
		end
	end
	if story.activeQuestId == QuestTable.CH3 and story.activeStepId == "ch3_s_job" then
		local key = "job_ch3_cemetery"
		local newCoins, granted, _ = Economy.payJobReward(profile.coins, 70, key, story.grantedRewards)
		if granted then
			story.grantedRewards[key] = true
			profile.coins = newCoins
			return QuestEngine.tryCompleteEvent(story, "ch3_cemetery_shift") ~= false
		end
	end
	return false
end

function StoryHandlers.handleDuelWin(profile: ProfileSchema.Profile): boolean
	local story = profile.story
	if story.activeQuestId == "q_initiation_duel" then
		local ok, grant = QuestEngine.tryCompleteEvent(story, "event:duel_razor_win")
		if ok and grant then
			applyGrants(profile, grant)
		end
		return ok
	end
	return false
end

function StoryHandlers.handleFlyerPost(profile: ProfileSchema.Profile, spotId: string): boolean
	local story = profile.story
	if story.activeQuestId ~= "q_initiation_graffiti" then
		return false
	end
	local posted = FlyerEngine.postSpot(story.flyersPosted, spotId)
	if not posted then
		return false
	end
	if story.activeQuestId == "q_initiation_graffiti" and FlyerEngine.isComplete(story.flyersPosted) then
		local ok, grant = QuestEngine.tryCompleteEvent(story, "event:flyers_done")
		if ok and grant then
			applyGrants(profile, grant)
		end
		return ok
	end
	return true
end

function StoryHandlers.handleHangoutBuild(profile: ProfileSchema.Profile, stage: string, answer: string): boolean
	local story = profile.story
	if story.activeQuestId ~= QuestTable.CH2 then
		return false
	end
	if stage ~= "foundation" and stage ~= "frame" and stage ~= "neon" and stage ~= "grand_open" then
		return false
	end
	if not HangoutMinigame.validate(stage :: HangoutMinigame.StageId, answer) then
		return false
	end
	local ok, count = HangoutEngine.complete(story.hangout, stage :: HangoutEngine.StageId)
	if not ok then
		return false
	end
	story.hangoutStage = count
	if HangoutEngine.isDone(story.hangout) then
		local done, grant = QuestEngine.trySpecial(story, "hangout_stage>=4", nil)
		if grant then
			applyGrants(profile, grant)
		end
		return done
	end
	return true
end

function StoryHandlers.handleCh2Antibully(profile: ProfileSchema.Profile, choice: string): boolean
	if choice ~= "stand" and choice ~= "join" then
		return false
	end
	QuestEngine.setDecision(profile.story, "ch2_bully", choice)
	if choice == "stand" then
		profile.story.relationships.razor = (profile.story.relationships.razor or 0) + 10
	else
		profile.story.relationships.razor = (profile.story.relationships.razor or 0) - 5
	end
	if profile.story.activeQuestId == "q_ch2_antibully" then
		QuestEngine.tryCompleteEvent(profile.story, "ch2_antibully_resolved")
		local g = QuestEngine.grantReward(profile.story, "reward_ch2_choice")
		applyGrants(profile, g)
	end
	return true
end

function StoryHandlers.handleCh3Ghost(profile: ProfileSchema.Profile, answer: string): boolean
	local story = profile.story
	if story.activeQuestId ~= QuestTable.CH3 or story.activeStepId ~= "ch3_s_ghost" then
		return false
	end
	local ok, nextStep = GhostRiddleEngine.submit(story.ghostRiddleStep, answer)
	if not ok then
		return false
	end
	story.ghostRiddleStep = nextStep
	if GhostRiddleEngine.isComplete(nextStep) then
		story.relationships.count = (story.relationships.count or 0) + 3
		return QuestEngine.tryCompleteEvent(story, "ch3_ghost_helped") ~= false
	end
	return true
end

function StoryHandlers.handleCh3Crypt(profile: ProfileSchema.Profile, phaseId: string, answer: string): boolean
	local story = profile.story
	if story.activeQuestId ~= QuestTable.CH3 or story.activeStepId ~= "ch3_s_crypt" then
		return false
	end
	if not CryptBuildEngine.validate(phaseId, answer, story.cryptPhase) then
		return false
	end
	story.cryptPhase += 1
	if CryptBuildEngine.isComplete(story.cryptPhase) then
		local ok, grant = QuestEngine.tryCompleteEvent(story, "ch3_crypt_built")
		if ok and grant then
			applyGrants(profile, grant)
		end
		return ok
	end
	return true
end

function StoryHandlers.handleCh4Enter(profile: ProfileSchema.Profile): boolean
	if not profile.story.uniqueItems.bell_rim then
		return false
	end
	if profile.story.activeQuestId == QuestTable.CH4 and profile.story.activeStepId == "ch4_s_enter" then
		return QuestEngine.tryCompleteEvent(profile.story, "ch4_castle_entered") ~= false
	end
	return false
end

function StoryHandlers.handleBellTongue(profile: ProfileSchema.Profile, branch: string): boolean
	if profile.story.activeQuestId ~= QuestTable.CH4 or profile.story.activeStepId ~= "ch4_s_tongue" then
		return false
	end
	if branch == "zoya" then
		if profile.story.uniqueItems.bell_tongue_zombie then
			return false
		end
		if QuestEngine.grantUniqueItem(profile.story, "bell_tongue_zoya") then
			return QuestEngine.tryCompleteEvent(profile.story, "ch4_tongue_obtained") ~= false
		end
	elseif branch == "zombie" then
		if profile.story.uniqueItems.bell_tongue_zoya then
			return false
		end
		if QuestEngine.grantUniqueItem(profile.story, "bell_tongue_zombie") then
			return QuestEngine.tryCompleteEvent(profile.story, "ch4_tongue_obtained") ~= false
		end
	end
	return false
end

function StoryHandlers.handleTowerPuzzle(
	profile: ProfileSchema.Profile,
	candles: { number },
	notes: { string }
): boolean
	if profile.story.activeQuestId ~= QuestTable.CH4 or profile.story.activeStepId ~= "ch4_s_crown" then
		return false
	end
	if not TowerPuzzle.validate(candles, notes) then
		return false
	end
	QuestEngine.grantUniqueItem(profile.story, "bell_crown")
	return QuestEngine.tryCompleteEvent(profile.story, "ch4_crown_obtained") ~= false
end

function StoryHandlers.handleConcert(profile: ProfileSchema.Profile, headliner: string): boolean
	if profile.story.activeQuestId ~= QuestTable.CH4 or profile.story.activeStepId ~= "ch4_s_concert" then
		return false
	end
	if headliner ~= "vienna" and headliner ~= "razor" and headliner ~= "count" and headliner ~= "ghost" then
		return false
	end
	profile.story.concertHeadliner = headliner
	profile.story.flags.concert_ready = true
	profile.story.relationships.count = (profile.story.relationships.count or 0) + 5
	return QuestEngine.tryCompleteEvent(profile.story, "ch4_concert_ready") ~= false
end

function StoryHandlers.handleConfession(profile: ProfileSchema.Profile): boolean
	if profile.story.activeQuestId ~= QuestTable.CH4 or profile.story.activeStepId ~= "ch4_s_confession" then
		return false
	end
	profile.story.flags.graph_truth = true
	profile.story.relationships.count = (profile.story.relationships.count or 0) + 8
	return QuestEngine.tryCompleteEvent(profile.story, "ch4_graph_confession") ~= false
end

function StoryHandlers.handleEnding(profile: ProfileSchema.Profile, endingId: string): boolean
	if not EndingLogic.canPick(profile.story, endingId :: EndingLogic.EndingId) then
		return false
	end
	if QuestEngine.pickEnding(profile.story, endingId) then
		local ending = QuestTable.endings[endingId]
		if ending then
			local g = QuestEngine.grantReward(profile.story, ending.grantKey)
			applyGrants(profile, g)
		end
		local world = workspace:FindFirstChild("World")
		if world and world:IsA("Folder") then
			WorldState.applyEnding(world, endingId)
		end
		return true
	end
	return false
end

function StoryHandlers.handleHouseZone(profile: ProfileSchema.Profile, zoneId: string): boolean
	local story = profile.story
	if story.activeStepId ~= "ch0_s_house" then
		return false
	end
	story.ch0HouseZones[zoneId] = true
	local count = 0
	for _, v in story.ch0HouseZones do
		if v then
			count += 1
		end
	end
	if count >= 2 then
		return QuestEngine.tryCompleteEvent(story, "ch0_house_tour") ~= false
	end
	return false
end

return StoryHandlers
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="47">
      <Properties>
        <string name="Name">WorldBuilder</string>
        <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RigFactory = require(script.Parent.RigFactory)
local FlyerEngine = require(ReplicatedStorage.Shared.FlyerEngine)

local WorldBuilder = {}

local function makePart(props: {
	Name: string,
	Size: Vector3,
	Position: Vector3,
	Color: Color3,
	Parent: Instance,
	Anchored: boolean?,
}): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Size = props.Size
	p.Position = props.Position
	p.Color = props.Color
	p.Anchored = if props.Anchored == nil then true else props.Anchored
	p.Material = Enum.Material.Concrete
	p.Parent = props.Parent
	return p
end

local function addZone(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3)
	local z = makePart({ Name = name, Size = size, Position = position, Color = color, Parent = parent })
	z.Transparency = 0.85
	z.CanCollide = false
	z:SetAttribute("ZoneId", name)
	return z
end

local function addFlyerSpot(parent: Instance, spotId: string, position: Vector3)
	local post = makePart({
		Name = spotId,
		Size = Vector3.new(2, 4, 0.2),
		Position = position,
		Color = Color3.fromRGB(255, 120, 200),
		Parent = parent,
	})
	post:SetAttribute("FlyerSpotId", spotId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Post flyer"
	prompt.ObjectText = "Flyer spot"
	prompt.MaxActivationDistance = 10
	prompt.Parent = post
end

function WorldBuilder.build(parent: Folder)
	parent:ClearAllChildren()

	local house = Instance.new("Folder")
	house.Name = "House13"
	house.Parent = parent
	makePart({
		Name = "Floor",
		Size = Vector3.new(40, 1, 40),
		Position = Vector3.new(0, 0, 0),
		Color = Color3.fromRGB(55, 50, 60),
		Parent = house,
	})
	addZone(house, "zone_room", Vector3.new(18, 8, 18), Vector3.new(-12, 4, -12), Color3.fromRGB(120, 80, 200))
	addZone(house, "zone_hall", Vector3.new(20, 8, 20), Vector3.new(8, 4, 0), Color3.fromRGB(80, 120, 200))
	makePart({
		Name = "marker_move",
		Size = Vector3.new(4, 1, 4),
		Position = Vector3.new(15, 1, 0),
		Color = Color3.fromRGB(255, 220, 80),
		Parent = house,
	})
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = Vector3.new(-5, 3, -5)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Parent = house
	RigFactory.spawnNpc(house, "npc_mom", Vector3.new(18, 0, 8), "Talk")
	RigFactory.spawnNpc(house, "npc_shnurok", Vector3.new(-18, 0, -8), "Pet")

	local street = Instance.new("Folder")
	street.Name = "Street"
	street.Parent = parent
	makePart({
		Name = "StreetFloor",
		Size = Vector3.new(60, 1, 30),
		Position = Vector3.new(80, 0, 0),
		Color = Color3.fromRGB(45, 45, 50),
		Parent = street,
	})
	addZone(street, "zone_street", Vector3.new(55, 10, 28), Vector3.new(80, 5, 0), Color3.fromRGB(255, 100, 180))
	RigFactory.spawnNpc(street, "npc_razor", Vector3.new(70, 0, 5), "Talk")
	local shop = makePart({
		Name = "Shop",
		Size = Vector3.new(14, 10, 14),
		Position = Vector3.new(100, 5, -10),
		Color = Color3.fromRGB(90, 40, 120),
		Parent = street,
	})
	shop:SetAttribute("ZoneId", "zone_shop")

	local city = Instance.new("Folder")
	city.Name = "City"
	city.Parent = parent
	makePart({
		Name = "CityFloor",
		Size = Vector3.new(40, 1, 40),
		Position = Vector3.new(80, 0, -60),
		Color = Color3.fromRGB(50, 50, 55),
		Parent = city,
	})

	local flyers = Instance.new("Folder")
	flyers.Name = "FlyerSpots"
	flyers.Parent = parent
	local spots = {
		{ "flyer_street_1", Vector3.new(65, 2, 8) },
		{ "flyer_street_2", Vector3.new(90, 2, 12) },
		{ "flyer_street_3", Vector3.new(75, 2, -5) },
		{ "flyer_city_1", Vector3.new(70, 2, -55) },
		{ "flyer_city_2", Vector3.new(90, 2, -70) },
		{ "flyer_city_3", Vector3.new(95, 2, -50) },
		{ "flyer_cemetery_gate", Vector3.new(5, 2, 105) },
		{ "flyer_shop_wall", Vector3.new(108, 4, -8) },
	}
	for _, pair in spots do
		if table.find(FlyerEngine.SPOT_IDS, pair[1]) then
			addFlyerSpot(flyers, pair[1], pair[2])
		end
	end

	local cemetery = Instance.new("Folder")
	cemetery.Name = "Cemetery"
	cemetery.Parent = parent
	makePart({
		Name = "CemeteryGround",
		Size = Vector3.new(50, 1, 50),
		Position = Vector3.new(0, 0, 120),
		Color = Color3.fromRGB(35, 50, 40),
		Parent = cemetery,
	})
	RigFactory.spawnNpc(cemetery, "npc_gravedigger", Vector3.new(-5, 0, 125), "Work")
	RigFactory.spawnNpc(cemetery, "npc_ghost", Vector3.new(10, 0, 130), "Help")
	local crypt = makePart({
		Name = "obj_crypt_site",
		Size = Vector3.new(12, 2, 12),
		Position = Vector3.new(-15, 1, 140),
		Color = Color3.fromRGB(50, 45, 55),
		Parent = cemetery,
	})
	local cp = Instance.new("ProximityPrompt")
	cp.ActionText = "Build crypt"
	cp.ObjectText = "Crypt"
	cp.MaxActivationDistance = 14
	cp.Parent = crypt

	local construction = Instance.new("Folder")
	construction.Name = "Construction"
	construction.Parent = parent
	for i, stageName in { "foundation", "frame", "neon", "grand_open" } do
		local part = makePart({
			Name = "hangout_" .. stageName,
			Size = Vector3.new(8, 2, 8),
			Position = Vector3.new(72 + i * 10, 1, 80),
			Color = Color3.fromRGB(60 + i * 20, 70, 90),
			Parent = construction,
		})
		part:SetAttribute("HangoutStage", stageName)
		local hp = Instance.new("ProximityPrompt")
		hp.ActionText = "Build: " .. stageName
		hp.MaxActivationDistance = 12
		hp.Parent = part
	end
	makePart({
		Name = "obj_hangout_site",
		Size = Vector3.new(20, 1, 20),
		Position = Vector3.new(80, 0, 80),
		Color = Color3.fromRGB(40, 40, 50),
		Parent = construction,
	})

	local duel = Instance.new("Folder")
	duel.Name = "DuelPit"
	duel.Parent = parent
	local arena = makePart({
		Name = "zone_duel",
		Size = Vector3.new(24, 1, 24),
		Position = Vector3.new(120, 0, 120),
		Color = Color3.fromRGB(80, 30, 30),
		Parent = duel,
	})
	arena:SetAttribute("ZoneId", "zone_duel")

	local castle = Instance.new("Folder")
	castle.Name = "Castle"
	castle.Parent = parent
	addZone(castle, "zone_castle_hall", Vector3.new(30, 10, 30), Vector3.new(-80, 5, 80), Color3.fromRGB(80, 50, 100))
	local tower = makePart({
		Name = "zone_castle_tower",
		Size = Vector3.new(12, 22, 12),
		Position = Vector3.new(-95, 11, 95),
		Color = Color3.fromRGB(50, 35, 70),
		Parent = castle,
	})
	tower:SetAttribute("ZoneId", "zone_castle_tower")
	for i = 1, 4 do
		local candle = makePart({
			Name = "candle_" .. i,
			Size = Vector3.new(1, 2, 1),
			Position = Vector3.new(-92 + i * 2, 3, 92),
			Color = Color3.fromRGB(255, 200, 80),
			Parent = castle,
		})
		candle:SetAttribute("CandleIndex", i)
	end
	local organ = makePart({
		Name = "organ_console",
		Size = Vector3.new(6, 3, 2),
		Position = Vector3.new(-88, 2, 98),
		Color = Color3.fromRGB(40, 30, 50),
		Parent = castle,
	})
	local noteOffset = { C = 0, D = 1, E = 2, G = 3 }
	for _, note in { "C", "D", "E", "G" } do
		local key = makePart({
			Name = "organ_" .. note,
			Size = Vector3.new(1.2, 0.4, 1.2),
			Position = Vector3.new(-90 + noteOffset[note], 3.5, 98),
			Color = Color3.fromRGB(120, 80, 160),
			Parent = organ,
		})
		key:SetAttribute("OrganNote", note)
	end
	RigFactory.spawnNpc(castle, "npc_count", Vector3.new(-80, 0, 80), "Talk")
	RigFactory.spawnNpc(castle, "npc_zoya", Vector3.new(-65, 0, 70), "Talk")
	makePart({
		Name = "zone_zombie_house",
		Size = Vector3.new(10, 8, 10),
		Position = Vector3.new(-55, 4, 90),
		Color = Color3.fromRGB(70, 90, 60),
		Parent = castle,
	}):SetAttribute("ZoneId", "zone_zombie_house")
end

return WorldBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="48">
      <Properties>
        <string name="Name">WorldState</string>
        <string name="Source"><![CDATA[--!strict
local WorldState = {}

function WorldState.applyEnding(world: Folder, endingId: string)
	local lighting = game:GetService("Lighting")
	if endingId == "ending_break_curse" then
		world:SetAttribute("EndingApplied", endingId)
		lighting.ClockTime = 6
		lighting.Brightness = 2.5
	elseif endingId == "ending_zombie_style" then
		world:SetAttribute("EndingApplied", endingId)
		lighting.ClockTime = 0
		lighting.Brightness = 1.2
	elseif endingId == "ending_count_deal" then
		world:SetAttribute("EndingApplied", endingId)
		lighting.ClockTime = 22
		lighting.Brightness = 1.8
	end
	local castle = world:FindFirstChild("Castle")
	if castle then
		castle:SetAttribute("EndingWorld", endingId)
	end
end

return WorldState
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="49">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  </Item>
