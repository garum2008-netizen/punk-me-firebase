{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'garum2008@gmail.com' && auth.token.email_verified === true))"
      }
    },
    "chat": {
      ".read": true,
      "$msgId": {
        ".write": "auth != null && (!data.exists() || (auth.token.email === 'garum2008@gmail.com' && auth.token.email_verified === true))"
      }
    }
  }
}
