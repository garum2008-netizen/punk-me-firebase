{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      ".write": false,
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999999"
        }
      }
    }
  }
}
