  "dialogues": {
    "dlg_life_ch1_outfit": {
      "nodes": {
        "n0": {
          "speaker": "player",
          "text": {
            "ru": "Выбери, как ты хочешь выглядеть сегодня. Только стиль — без давления.",
            "en": "Pick how you want to look today. Style only — no pressure.",
            "da": "Vælg dit look i dag."
          },
          "choices": [
            {
              "id": "calm",
              "text": { "ru": "Спокойный стиль", "en": "Calm look", "da": "Roligt look" },
              "flag": "outfit_calm"
            },
            {
              "id": "bright",
              "text": { "ru": "Яркий стиль", "en": "Bright look", "da": "Klar stil" },
              "flag": "outfit_bright"
            },
            {
              "id": "bold",
              "text": { "ru": "Смелый стиль", "en": "Bold look", "da": "Modigt look" },
              "flag": "outfit_bold"
            }
          ]
        }
      }
    },
    "dlg_life_ch1_trust": {
      "nodes": {
        "n0": {
          "speaker": "player",
          "text": {
            "ru": "На тумбочке лежит записка. Что делать?",
            "en": "There's a note on the desk. What should I do?",
            "da": "Der ligger en seddel. Hvad gør jeg?"
          },
          "choices": [
            {
              "id": "secret",
              "text": { "ru": "Спрятать и подумать", "en": "Hide it and think", "da": "Gem den" },
              "flag": "mystery_secret"
            },
            {
              "id": "open",
              "text": { "ru": "Рассказать Мире позже", "en": "Tell Mira later", "da": "Fortæl Mira senere" },
              "flag": "mystery_open"
            },
            {
              "id": "trust_mira",
              "text": { "ru": "Довериться Мире", "en": "Trust Mira", "da": "Stol på Mira" },
              "flag": "mystery_trust_angelina"
            }
          ]
        },
        "n_after_calm": {
          "speaker": "player",
          "text": {
            "ru": "Спокойный образ — хороший знак. На тумбочке записка. Что делать?",
            "en": "Calm look suits me. There's a note on the desk. What should I do?",
            "da": "Roligt look. Der ligger en seddel."
          },
          "choices": [
            {
              "id": "secret",
              "text": { "ru": "Спрятать и подумать", "en": "Hide it and think", "da": "Gem den" },
              "flag": "mystery_secret"
            },
            {
              "id": "open",
              "text": { "ru": "Рассказать Мире позже", "en": "Tell Mira later", "da": "Fortæl Mira senere" },
              "flag": "mystery_open"
            },
            {
              "id": "trust_mira",
              "text": { "ru": "Довериться Мире", "en": "Trust Mira", "da": "Stol på Mira" },
              "flag": "mystery_trust_angelina"
            }
          ]
        },
        "n_after_bright": {
          "speaker": "player",
          "text": {
            "ru": "Ярко! Записка на тумбочке — не для всех глаз. Решай сама.",
            "en": "Bold colors! The note on the desk isn't for everyone. My call.",
            "da": "Klar stil! Der ligger en seddel."
          },
          "choices": [
            {
              "id": "secret",
              "text": { "ru": "Спрятать и подумать", "en": "Hide it and think", "da": "Gem den" },
              "flag": "mystery_secret"
            },
            {
              "id": "open",
              "text": { "ru": "Рассказать Мире позже", "en": "Tell Mira later", "da": "Fortæl Mira senere" },
              "flag": "mystery_open"
            },
            {
              "id": "trust_mira",
              "text": { "ru": "Довериться Мире", "en": "Trust Mira", "da": "Stol på Mira" },
              "flag": "mystery_trust_angelina"
            }
          ]
        },
        "n_after_bold": {
          "speaker": "player",
          "text": {
            "ru": "Смело. Записка ждёт — если ошибусь, последствия будут позже.",
            "en": "Brave look. The note can wait — but wrong moves echo later.",
            "da": "Modigt look. Sedlen venter."
          },
          "choices": [
            {
              "id": "secret",
              "text": { "ru": "Спрятать и подумать", "en": "Hide it and think", "da": "Gem den" },
              "flag": "mystery_secret"
            },
            {
              "id": "open",
              "text": { "ru": "Рассказать Мире позже", "en": "Tell Mira later", "da": "Fortæl Mira senere" },
              "flag": "mystery_open"
            },
            {
              "id": "trust_mira",
              "text": { "ru": "Довериться Мире", "en": "Trust Mira", "da": "Stol på Mira" },
              "flag": "mystery_trust_angelina"
            }
          ]
        }
      }
    },
    "dlg_life_ch1_reflect": {
      "nodes": {
        "n_secret": {
          "speaker": "player",
          "text": {
            "ru": "Хорошо. Пока никому — пока сама не решишь иначе.",
            "en": "Okay. No one else for now — until I decide otherwise.",
            "da": "Okay. Ingen andre endnu."
          },
          "requiresFlag": "mystery_secret"
        },
        "n_open": {
          "speaker": "mira",
          "text": {
            "ru": "Ангелина, лучше расскажи мне сама — обидно узнать от других.",
            "en": "Angelina, tell me yourself — it hurts to hear it second-hand.",
            "da": "Angelina, fortæl mig det selv."
          },
          "requiresFlag": "mystery_open"
        },
        "n_trust": {
          "speaker": "mira",
          "text": {
            "ru": "Спасибо, Ангелина. Я рядом — без геройства, обещаю.",
            "en": "Thanks, Angelina. I'm here for you — no heroics, I promise.",
            "da": "Tak, Angelina. Jeg er her."
          },
          "requiresFlag": "mystery_trust_angelina"
        },
        "n_fallback": {
          "speaker": "player",
          "text": {
            "ru": "Ты уже сделала выбор — помни его.",
            "en": "You already chose — remember it.",
            "da": "Du har allerede valgt."
          }
        }
      }
    }
  }
