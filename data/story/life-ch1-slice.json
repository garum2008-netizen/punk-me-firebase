  "dialogues": {
    "dlg_life_ch1_outfit": {
      "nodes": {
        "n0": {
          "speaker": "player",
          "text": {
            "ru": "Стою у зеркала — какой образ на сегодня?",
            "en": "What look do I want today? At the mirror — style only.",
            "da": "Hvilket look vil jeg have i dag?"
          },
          "choices": [
            {
              "id": "calm",
              "text": { "ru": "Спокойный стиль", "en": "Calm look", "da": "Roligt look" },
              "flag": "outfit_calm"
            },
            {
              "id": "bright",
              "text": { "ru": "Яркий стиль", "en": "Bright look", "da": "Klar stil" },
              "flag": "outfit_bright"
            },
            {
              "id": "bold",
              "text": { "ru": "Смелый стиль", "en": "Bold look", "da": "Modigt look" },
              "flag": "outfit_bold"
            }
          ]
        }
      }
    },
    "dlg_life_ch1_trust": {
      "nodes": {
        "n0": {
          "speaker": "player",
          "text": {
            "ru": "На тумбочке лежит записка. Что мне делать?",
            "en": "There's a note on the nightstand. What should I do?",
            "da": "Der ligger en seddel. Hvad gør jeg?"
          },
          "choices": [
            {
              "id": "secret",
              "text": { "ru": "Спрятать и подумать", "en": "Hide it and think", "da": "Gem den" },
              "flag": "mystery_secret"
            },
            {
              "id": "open",
              "text": { "ru": "Рассказать Мире позже", "en": "Tell Mira later", "da": "Fortæl Mira senere" },
              "flag": "mystery_open"
            },
            {
              "id": "trust_mira",
              "text": { "ru": "Довериться Мире", "en": "Trust Mira", "da": "Stol på Mira" },
              "flag": "mystery_trust_angelina"
            }
          ]
        },
        "n_after_calm": {
          "speaker": "player",
          "text": {
            "ru": "Спокойный образ — хороший знак. На тумбочке записка. Что мне делать?",
