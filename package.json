{
  "name": "punk-me",
  "private": true,
  "description": "PUNK ME — оригинальная неоновая панк-банда (Firebase + статический хостинг)",
  "scripts": {
    "start": "npx --yes serve -l 3456 .",
    "lint": "node scripts/smoke-check.js",
    "test": "node scripts/smoke-check.js",
    "test:loading": "node scripts/test-loading-recovery.js",
    "test:loading-early-save": "node scripts/test-loading-early-save.js",
    "test:accounts": "node scripts/test-accounts-auth.js",
    "test:save-sanitize": "node scripts/test-save-sanitize.js",
    "test:earn-state": "node scripts/test-earn-state.mjs",
    "test:story-preview": "node scripts/test-story-preview-smoke.js",
    "test:quest-table-sync": "node scripts/test-quest-table-sync.mjs",
    "test:ch0-p0": "node scripts/test-ch0-p0.mjs",
    "test:p1-gameplay-economy": "node scripts/test-p1-gameplay-economy.mjs",
    "test:p0-first-10min": "node scripts/p0-first-10min-playthrough.js",
    "test:newcomer-no-force": "node scripts/newcomer-no-force-playthrough.js",
    "test:honest-first10-e2e": "node scripts/honest-first10-e2e.mjs",
    "test:rules": "node scripts/run-rules-emulator.js",
    "list:test-artifacts": "node scripts/list-test-artifacts.mjs",
    "generate:voice-audit-samples": "node scripts/generate-voice-audit-samples.mjs",
    "test:deploy-order": "node scripts/test-deploy-order-phase.js a1 && sleep 20 && node scripts/test-deploy-order-phase.js a2 && sleep 20 && node scripts/test-deploy-order-phase.js b",
    "test:emulator": "node scripts/run-emulator-integration.js",
    "generate:audio": "node scripts/generate-audio-assets.mjs",
    "generate:voice": "node scripts/build-voice-lines.mjs && node scripts/generate-voice-piper.mjs",
    "test:voice-narrator": "node scripts/test-voice-narrator-inna.js",
    "test:pr-a": "node scripts/test-pr-a-quality.js",
    "test:pr-b": "node scripts/test-pr-b-build.js",
    "test:duel-onboarding": "node scripts/test-duel-onboarding-e2e.js",
    "download:music": "node scripts/download-licensed-music.mjs",
    "record:pr-b": "node scripts/record-pr-b-full-playthrough.js",
    "finalize:pr-b": "node scripts/finalize-pr-b-capture.js",
    "check:pr-b-duel": "node scripts/check-pr-b-duel-mark.js",
    "record:content": "node scripts/record-content-clips.js",
    "record:angelina-long": "node scripts/record-angelina-long.js",
    "refinalize:content": "node scripts/refinalize-content-clips.js",
    "proof:idle": "node scripts/proof-idle-stability.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.29.1",
    "playwright": "^1.64.1"
  }
}
